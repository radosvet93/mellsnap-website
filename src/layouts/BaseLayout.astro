---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

import loraRegular from "../fonts/lora-v37-latin-regular.woff2";
import ephesisRegular from "../fonts/ephesis-v11-latin-regular.woff2";
import cormorant500 from "../fonts/cormorant-garamond-v21-latin-500.woff2";
import raleway500 from "../fonts/raleway-v37-latin-500.woff2";


import { shareImageUrl } from "../utils/shareImage";
import defaultShareImage from "../images/hero-mums-babies.webp";

interface Props {
  title: string;
  description?: string;
  // Photo shown when the page is shared on social media
  ogImage?: string | ImageMetadata;
  ogType?: "website" | "article";
}

const {
  title,
  description = "MellSnap Photography - Family & Event Photography in Kingston upon Thames and Central London",
  ogImage = defaultShareImage,
  ogType = "website",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, "https://mellsnap.co.uk").href;
const ogImageUrl = await shareImageUrl(ogImage);
// Titles that already name the brand are used as-is
const fullTitle = title.includes("MellSnap") ? title : `${title} | MellSnap Photography`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/images/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Font preloads -->
    <link rel="preload" href={loraRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ephesisRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorant500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={raleway500} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="MellSnap Photography" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- GLOBAL JSON-LD -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": [
          "LocalBusiness",
          "ProfessionalService",
          "PhotographyBusiness"
        ],
        "@id": "https://mellsnap.co.uk/#business",
        "name": "MellSnap Photography",
        "url": "https://mellsnap.co.uk",
        "description": "Family, maternity, children and event photography in Kingston upon Thames and Central London.",
        "telephone": "+447722050936",
        "email": "contact@mellsnap.co.uk",

        "image": "https://mellsnap.co.uk/images/mellsnap-logo-trans.png",
        "logo": "https://mellsnap.co.uk/images/mellsnap-logo-trans.png",

        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Kingston upon Thames",
          "addressRegion": "London",
          "addressCountry": "GB"
        },

        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 51.41427,
          "longitude": -0.304613
        },

        "hasMap": "https://maps.google.com/?q=51.41427,-0.304613",

        "areaServed": [
          { "@type": "City", "name": "Kingston upon Thames" },
          { "@type": "City", "name": "Richmond" },
          { "@type": "City", "name": "Wimbledon" },
          { "@type": "City", "name": "Twickenham" },
          { "@type": "City", "name": "Teddington" },
          { "@type": "City", "name": "Surbiton" },
          { "@type": "City", "name": "Chelsea" },
          { "@type": "City", "name": "Kensington" }
        ],

        "serviceArea": {
          "@type": "AdministrativeArea",
          "name": "London"
        },

        "sameAs": [
          "https://instagram.com/mellsnap",
          "https://facebook.com/mellphotosnap",
          "https://pinterest.com/mellsnap"
        ],

        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+447722050936",
          "contactType": "customer service"
        },

        "priceRange": "££"
      }
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "vsqt3u57hx");
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
    <ScrollToTop />
    <!-- 100% privacy-first analytics -->
    <script
      is:inline
      async
      src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
  </body>
</html>
