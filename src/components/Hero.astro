---
import Button from "./Button.astro";

interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  ctaText?: string;
  ctaLink?: string;
  overlay?: boolean;
}

const { title, subtitle, ctaText, ctaLink, overlay = true } = Astro.props;

import { Image } from "astro:assets";
import heroImage from "../images/hero-home-page.webp";
---

<section
  class="relative min-h-[70vh] md:min-h-[80vh] flex items-center justify-center"
>
  <!-- Background Image -->
  <div class="absolute inset-0">
    <Image
      src={heroImage}
      alt="Mother holding her child in a park and posing for a family photo"
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />

    {overlay && <div class="absolute inset-0 bg-black/50" />}
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 py-20 max-w-4xl">
    <h1 class="text-white leading-tight mb-6">
      {title}
    </h1>
    {
      subtitle && (
        <p class="font-ephesis text-3xl md:text-4xl lg:text-5xl text-white/90 mb-10">
          {subtitle}
        </p>
      )
    }
    {
      ctaText && ctaLink && (
        <Button href={ctaLink} variant="primary">
          {ctaText}
        </Button>
      )
    }
  </div>
</section>
