---
const simpleLinks = [
  { href: "/free-consultation/", label: "Book Me" },
  { href: "/about/", label: "About" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
];

const portfolioLinks = [
  { href: "/portfolio/family/", label: "Family" },
  { href: "/portfolio/love/", label: "Couples" },
  { href: "/portfolio/maternity/", label: "Maternity" },
  { href: "/portfolio/events/", label: "Events" },
  { href: "/portfolio/children/", label: "Children" },
];

const serviceLinks = [
  { href: "/quick-photoshoot/", label: "Quick Photoshoot" },
  { href: "/full-photoshoot/", label: "Full Photoshoot" },
  { href: "/event-photography/", label: "Event Photoshoot" },
];

const currentPath = Astro.url.pathname;
import { Image } from "astro:assets";
import logo from "../images/mellsnap-logo-trans.png";

const isPortfolioActive = currentPath.startsWith("/portfolio/");
const isServicesActive =
  currentPath === "/services/" ||
  currentPath === "/quick-photoshoot/" ||
  currentPath === "/full-photoshoot/" ||
  currentPath === "/event-photography/";
---

<header class="py-4 bg-white">
  <div class="container">
    <!-- Mobile top bar: logo left, burger right. Desktop: logo centered above nav -->
    <div class="flex items-center justify-between md:flex md:justify-center md:mb-4">
      <a href="/" class="inline-block">
        <Image
          src={logo}
          height={204}
          width={885}
          alt="MellSnap Photography Logo"
          class="w-40 md:w-56"
        />
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 border border-pink"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Navigation -->
    <nav id="nav-menu" class="hidden md:block">
      <ul class="flex flex-col md:flex-row md:justify-center md:items-center gap-0 md:gap-10">

        <!-- Portfolio Dropdown -->
        <li class="relative group w-full md:w-auto border-b border-gray-300 md:border-none">
          <!-- Row: link left, chevron right (mobile) / link + chevron inline (desktop) -->
          <div class="relative flex items-center md:justify-center md:gap-1 py-3 md:py-0">
            <a
              href="/portfolio/"
              class:list={[
                "nav-link hover:text-pink transition-colors",
                { "text-pink": isPortfolioActive },
              ]}
            >
              Portfolio
            </a>
            <!-- Desktop chevron -->
            <svg
              class="w-3 h-3 hidden md:block transition-transform duration-200 group-hover:rotate-180 opacity-60 pointer-events-none"
              fill="none" stroke="currentColor" viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
            <!-- Mobile chevron button (absolute so it doesn't affect row height) -->
            <button
              class="md:hidden mobile-dropdown-btn absolute right-0 inset-y-0 flex items-center justify-center w-11 text-pink"
              data-target="portfolio-submenu"
              aria-label="Toggle portfolio submenu"
              aria-expanded="false"
            >
              <svg class="w-5 h-5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
          </div>

          <!-- Desktop dropdown (hover) -->
          <ul class="hidden md:group-hover:block absolute top-full left-1/2 -translate-x-1/2 bg-white shadow-md min-w-[160px] z-50 pt-4 pb-2">
            {portfolioLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "nav-link block px-5 py-2 hover:text-pink hover:bg-section-bg transition-colors whitespace-nowrap",
                    { "text-pink": currentPath === link.href },
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>

          <!-- Mobile submenu -->
          <ul id="portfolio-submenu" class="hidden md:hidden flex-col gap-0 pb-2">
            {portfolioLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "nav-link block py-2 pl-4 hover:text-pink transition-colors opacity-80",
                    { "text-pink": currentPath === link.href },
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </li>

        <!-- Services Dropdown -->
        <li class="relative group w-full md:w-auto border-b border-gray-300 md:border-none">
          <div class="relative flex items-center md:justify-center md:gap-1 py-3 md:py-0">
            <a
              href="/services/"
              class:list={[
                "nav-link hover:text-pink transition-colors",
                { "text-pink": isServicesActive },
              ]}
            >
              Services
            </a>
            <!-- Desktop chevron -->
            <svg
              class="w-3 h-3 hidden md:block transition-transform duration-200 group-hover:rotate-180 opacity-60 pointer-events-none"
              fill="none" stroke="currentColor" viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
            <!-- Mobile chevron button (absolute so it doesn't affect row height) -->
            <button
              class="md:hidden mobile-dropdown-btn absolute right-0 inset-y-0 flex items-center justify-center w-11 text-pink"
              data-target="services-submenu"
              aria-label="Toggle services submenu"
              aria-expanded="false"
            >
              <svg class="w-5 h-5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
          </div>

          <!-- Desktop dropdown (hover) -->
          <ul class="hidden md:group-hover:block absolute top-full left-1/2 -translate-x-1/2 bg-white shadow-md min-w-[180px] z-50 pt-4 pb-2">
            {serviceLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "nav-link block px-5 py-2 hover:text-pink hover:bg-section-bg transition-colors whitespace-nowrap",
                    { "text-pink": currentPath === link.href },
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>

          <!-- Mobile submenu -->
          <ul id="services-submenu" class="hidden md:hidden flex-col gap-0 pb-2">
            {serviceLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "nav-link block py-2 pl-4 hover:text-pink transition-colors opacity-80",
                    { "text-pink": currentPath === link.href },
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </li>

        <!-- Simple Links -->
        {simpleLinks.map((link) => (
          <li class="w-full md:w-auto border-b border-gray-300 md:border-none">
            <a
              href={link.href}
              class:list={[
                "nav-link block py-3 md:py-0 hover:text-pink transition-colors",
                { "text-pink": currentPath === link.href },
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const navMenu = document.getElementById("nav-menu");
  const header = menuBtn?.closest("header");

  menuBtn?.addEventListener("click", () => {
    const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
    menuBtn.setAttribute("aria-expanded", (!isExpanded).toString());
    navMenu?.classList.toggle("hidden");
  });

  document.addEventListener("click", (e) => {
    if (!header?.contains(e.target as Node) && !navMenu?.classList.contains("hidden")) {
      navMenu?.classList.add("hidden");
      menuBtn?.setAttribute("aria-expanded", "false");
    }
  });

  document.querySelectorAll(".mobile-dropdown-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = (btn as HTMLElement).dataset.target!;
      const submenu = document.getElementById(targetId);
      const chevron = btn.querySelector("svg");
      const isExpanded = btn.getAttribute("aria-expanded") === "true";

      btn.setAttribute("aria-expanded", (!isExpanded).toString());
      submenu?.classList.toggle("hidden");
      submenu?.classList.toggle("flex");
      chevron?.classList.toggle("rotate-180");
    });
  });
</script>
