<dialog
  id="lightbox"
  class="fixed inset-0 m-0 p-0 w-screen h-screen max-w-none max-h-none bg-transparent backdrop:bg-black/80"
>
  <div class="relative w-full h-full flex items-center justify-center">
    <button
      id="lb-close"
      aria-label="Close"
      class="absolute top-4 right-4 z-10 text-white text-5xl leading-none w-14 h-14 flex items-center justify-center hover:text-pink transition-colors cursor-pointer"
      >&times;</button
    >

    <span
      id="lb-counter"
      class="absolute top-2 left-1/2 -translate-x-1/2 z-10 text-white/70 text-sm font-raleway tracking-widest pb-4"
    ></span>

    <button
      id="lb-prev"
      aria-label="Previous"
      class="absolute left-4 z-10 text-white text-5xl leading-none w-14 h-14 flex items-center justify-center hover:text-pink transition-colors select-none cursor-pointer"
      >&#8249;</button
    >

    <img
      id="lb-img"
      src=""
      alt=""
      class="max-h-[90vh] max-w-[90vw] object-contain transition-opacity duration-300"
    />

    <button
      id="lb-next"
      aria-label="Next"
      class="absolute right-4 z-10 text-white text-5xl leading-none w-14 h-14 flex items-center justify-center hover:text-pink transition-colors select-none cursor-pointer"
      >&#8250;</button
    >
  </div>
</dialog>

<style>
  #lightbox {
    backdrop-filter: blur(4px);
    transition: opacity 0.3s ease;
  }

  #lightbox[open] {
    opacity: 1;
  }

  @starting-style {
    #lightbox[open] {
      opacity: 0;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const dialog = document.getElementById("lightbox");
    const img = document.getElementById("lb-img");
    const counter = document.getElementById("lb-counter");
    const btnClose = document.getElementById("lb-close");
    const btnPrev = document.getElementById("lb-prev");
    const btnNext = document.getElementById("lb-next");

    let images = [];
    let current = 0;

    function collectImages() {
      images = Array.from(document.querySelectorAll("img.img-portfolio"));
      images.forEach((el, i) => {
        el.addEventListener("click", () => open(i));
      });
    }

    function updateCounter() {
      counter.textContent =
        images.length > 1 ? `${current + 1} / ${images.length}` : "";
    }

    function preload(index) {
      for (let i = index - 3; i <= index + 3; i++) {
        if (i === index) continue;
        const src = images[(i + images.length) % images.length]?.src;
        if (src) new Image().src = src;
      }
    }

    function show(index) {
      current = (index + images.length) % images.length;

      const el = images[current];

      img.src = el.src;
      img.alt = el.alt;

      updateCounter();
      preload(current);
    }

    function open(index) {
      current = (index + images.length) % images.length;
      const el = images[current];
      img.src = el.src;
      img.alt = el.alt;
      updateCounter();
      preload(current);
      const scrollbarWidth =
        window.innerWidth - document.documentElement.clientWidth;
      document.body.style.paddingRight = `${scrollbarWidth}px`;
      document.body.style.overflow = "hidden";
      dialog.showModal();
    }

    function closeDialog() {
      dialog.close();
    }

    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
      document.body.style.paddingRight = "";
    });

    btnClose.addEventListener("click", closeDialog);
    btnPrev.addEventListener("click", () => show(current - 1));
    btnNext.addEventListener("click", () => show(current + 1));

    dialog.addEventListener("click", (e) => {
      if (btnPrev.contains(e.target) || btnNext.contains(e.target)) return;
      closeDialog();
    });

    document.addEventListener("keydown", (e) => {
      if (!dialog.open) return;
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });

    let touchStartX = 0;
    dialog.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.touches[0].clientX;
      },
      { passive: true },
    );
    dialog.addEventListener(
      "touchend",
      (e) => {
        const delta = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(delta) > 50) show(current + (delta < 0 ? 1 : -1));
      },
      { passive: true },
    );

    collectImages();
  });
</script>
