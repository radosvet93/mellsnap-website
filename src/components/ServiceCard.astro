---
import Button from "./Button.astro";

interface Props {
  title: string;
  price: string;
  duration: string;
  features: string[];
  ctaText?: string;
  ctaLink?: string;
  featured?: boolean;
}

const {
  title,
  price,
  duration,
  features,
  ctaText = "Select",
  ctaLink = "/free-consultation/",
  featured = false,
} = Astro.props;
---

<div
  class:list={[
    "bg-white p-8 md:p-10 text-center",
    { "border-2 border-pink": featured },
  ]}
>
  <h3 class="font-ephesis text-pink mb-4">
    {title}
  </h3>
  <p class="font-medium text-primary-text">
    {price}
  </p>
  <p class="font-raleway text-sm italic text-secondary-text tracking-wide mb-8">
    {duration}
  </p>

  <ul class="space-y-4 mb-10">
    {
      features.map((feature) => (
        <li class=" text-secondary-text flex items-center justify-center gap-2">
          <svg
            class="w-5 h-5 text-green shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"
            />
          </svg>
          {feature}
        </li>
      ))
    }
  </ul>

  <Button href={ctaLink} variant={featured ? "primary" : "secondary"}>
    {ctaText}
  </Button>
</div>
