---
interface Props {
  quote: string;
  name: string;
  rating?: number;
}

const { quote, name, rating = 5 } = Astro.props;
---

<div class="bg-white p-6 md:p-6 text-center">
  <!-- Stars -->
  <div class="flex justify-center gap-1 mb-6">
    {
      Array.from({ length: 5 }).map((_, i) => (
        <svg
          class:list={["w-5 h-5", i < rating ? "text-amber-500" : "text-beige"]}
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))
    }
  </div>

  <!-- Quote -->
  <blockquote class="text-primary-text italic leading-relaxed mb-3 md:mb-6">
    <span class="quote-text line-clamp-3 md:line-clamp-none">"{quote}"</span>
  </blockquote>

  <!-- Read more (mobile only) -->
  <button
    class="read-more-btn text-pink text-sm underline mb-4 md:hidden"
    aria-expanded="false"
  >Read more</button>

  <!-- Name -->
  <p class="font-ephesis text-green">{name}</p>
</div>

<script>
  document.querySelectorAll(".read-more-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const card = btn.closest("div");
      const text = card?.querySelector(".quote-text");
      const expanded = btn.getAttribute("aria-expanded") === "true";
      if (expanded) {
        text?.classList.add("line-clamp-3");
        btn.textContent = "Read more";
        btn.setAttribute("aria-expanded", "false");
      } else {
        text?.classList.remove("line-clamp-3");
        btn.textContent = "Read less";
        btn.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
