---
import Button from "./Button.astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  image: string;
  href: string;
  category?: string;
}

const { title, image, href } = Astro.props;
---

<a
  href={href}
  class="block shadow-xl overflow-hidden hover:shadow-lg transition-shadow duration-300 ease-in-out"
>
  <div class="aspect-4/5">
    <Image
      src={image}
      alt={title}
      inferSize
      class="w-full h-full object-cover p-6"
      loading="lazy"
    />
    <div class="flex items-center justify-center">
      <div class="text-center pb-6">
        <h3 class="text-2xl font-bold">{title}</h3>
      </div>
    </div>
  </div>
  <Button class="block w-full group "
    >Go to {title} gallery

    <svg class="inline w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"
      ><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g
        id="SVGRepo_tracerCarrier"
        stroke-linecap="round"
        stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier">
        <path
          d="M9 19L16 12L9 5"
          stroke="#ffffff"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </g></svg
    >
  </Button>
</a>
