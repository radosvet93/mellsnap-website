---
export interface Faq {
  question: string;
  answer: string;
  // Optional HTML version of the answer, e.g. with links
  answerHtml?: string;
}

interface Props {
  faqs: Faq[];
  title?: string;
}

const { faqs, title = "Frequently Asked Questions" } = Astro.props;
---

<section class="py-20 md:py-28 bg-linen">
  <div class="container">
    <div class="text-center mb-16">
      <p class="label mb-4">FAQ</p>
      <h2 class="text-4xl md:text-5xl text-primary-text">{title}</h2>
    </div>

    <div class="max-w-3xl mx-auto divide-y divide-primary-text/15">
      {
        faqs.map((faq) => (
          <details class="group py-4">
            <summary class="flex justify-between items-center gap-4 cursor-pointer list-none font-cormorant text-lg font-semibold text-primary-text">
              {faq.question}
              <svg
                class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 448 512"
                aria-hidden="true"
              >
                <path d="M224 416c-8.188 0-16.38-3.125-22.62-9.375l-192-192c-12.5-12.5-12.5-32.75 0-45.25s32.75-12.5 45.25 0L224 338.8l169.4-169.4c12.5-12.5 32.75-12.5 45.25 0s12.5 32.75 0 45.25l-192 192C240.4 412.9 232.2 416 224 416z" />
              </svg>
            </summary>
            <p
              class="mt-3 text-secondary-text"
              set:html={faq.answerHtml ?? faq.answer}
            />
          </details>
        ))
      }
    </div>
  </div>
</section>
