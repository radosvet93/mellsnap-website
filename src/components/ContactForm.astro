---
import Button from './Button.astro';
---

<form class="max-w-xl mx-auto space-y-6">
  <div>
    <label for="name" class="label block mb-2">Name</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      class="w-full px-4 py-3 border border-beige bg-white font-cormorant text-lg focus:border-gold focus:outline-none transition-colors"
      placeholder="Your name"
    />
  </div>

  <div>
    <label for="email" class="label block mb-2">Email</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full px-4 py-3 border border-beige bg-white font-cormorant text-lg focus:border-gold focus:outline-none transition-colors"
      placeholder="your@email.com"
    />
  </div>

  <div>
    <label for="phone" class="label block mb-2">Phone (optional)</label>
    <input
      type="tel"
      id="phone"
      name="phone"
      class="w-full px-4 py-3 border border-beige bg-white font-cormorant text-lg focus:border-gold focus:outline-none transition-colors"
      placeholder="+44 7XXX XXX XXX"
    />
  </div>

  <div>
    <label for="service" class="label block mb-2">Service interested in</label>
    <select
      id="service"
      name="service"
      class="w-full px-4 py-3 border border-beige bg-white font-cormorant text-lg focus:border-gold focus:outline-none transition-colors"
    >
      <option value="">Select a service</option>
      <option value="quick">Quick Session (20 min)</option>
      <option value="full">Full Session (1 hour)</option>
      <option value="event">Event Coverage</option>
      <option value="other">Other / Not sure</option>
    </select>
  </div>

  <div>
    <label for="message" class="label block mb-2">Message</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="w-full px-4 py-3 border border-beige bg-white font-cormorant text-lg focus:border-gold focus:outline-none transition-colors resize-none"
      placeholder="Tell me about your session..."
    ></textarea>
  </div>

  <div class="text-center pt-4">
    <Button type="submit" variant="primary">
      Send Message
    </Button>
  </div>
</form>
