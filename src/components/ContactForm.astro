---
import Button from "./Button.astro";
---

<form
  id="contact-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="max-w-xl mx-auto space-y-6"
>
  <!-- Web3Forms Access Key -->
  <input
    type="hidden"
    name="access_key"
    value="f44bf584-6276-4cff-bc9f-3338b4e362cb"
  />

  <!-- Success/Error Messages -->
  <div id="form-message" class="hidden"></div>

  <div>
    <label for="name" class="label block mb-2">Name</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      autocomplete="name"
      class="w-full px-4 py-3 border bg-white focus:border-pink focus:outline-none transition-colors"
      placeholder="Your name"
    />
  </div>

  <div>
    <label for="email" class="label block mb-2">Email</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      autocomplete="email"
      class="w-full px-4 py-3 border bg-white focus:border-pink focus:outline-none transition-colors"
      placeholder="your@email.com"
    />
  </div>

  <div>
    <label for="phone" class="label block mb-2">Phone (optional)</label>
    <input
      type="tel"
      id="phone"
      name="phone"
      autocomplete="tel"
      class="w-full px-4 py-3 border bg-white focus:border-pink focus:outline-none transition-colors"
      placeholder="+44 7XXX XXX XXX"
    />
  </div>

  <div>
    <label for="service" class="label block mb-2">Service interested in</label>
    <select
      id="service"
      name="service"
      class="w-full px-4 py-3 border bg-white focus:border-pink focus:outline-none transition-colors"
    >
      <option value="">Select a service</option>
      <option value="quick">Quick Session (20 min)</option>
      <option value="full">Full Session (1 hour)</option>
      <option value="event">Event Coverage</option>
      <option value="other">Other / Not sure</option>
    </select>
  </div>

  <div>
    <label for="message" class="label block mb-2">Message</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="w-full px-4 py-3 border bg-white focus:border-pink focus:outline-none transition-colors resize-none"
      placeholder="Tell me about your session..."></textarea>
  </div>

  <!-- hCaptcha -->
  <div class="h-captcha" data-captcha="true"></div>

  <div class="text-center pt-4">
    <Button type="submit" variant="primary"> Send Message </Button>
  </div>
</form>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const message = document.getElementById("form-message") as HTMLDivElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const submitButton = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    const originalText = submitButton.textContent;

    // Disable button and show loading state
    submitButton.disabled = true;
    submitButton.textContent = "Sending...";

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData,
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Success
        message.textContent =
          "Thank you! Your message has been sent successfully. I'll get back to you soon.";
        message.className =
          "p-4 bg-green-100 text-green-800 border border-green-300 rounded  ";
        form.reset();
      } else {
        // Error from Web3Forms
        throw new Error(data.message || "Something went wrong");
      }
    } catch (error) {
      // Network or other error
      message.textContent =
        "Sorry, there was an error sending your message. Please try again.";
      message.className =
        "p-4 bg-red-100 text-red-800 border border-red-300 rounded  ";
    } finally {
      // Re-enable button
      submitButton.disabled = false;
      submitButton.textContent = originalText;

      // Scroll to message
      message.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  });
</script>

<script is:inline src="https://web3forms.com/client/script.js" async defer
></script>
