---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PortfolioCarousel from "../components/PortfolioCarousel.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import Button from "../components/Button.astro";

const services = [
  {
    title: "Quick Session",
    price: "£180",
    duration: "20 minutes",
    features: [
      "30+ digital images",
      "Fully edited photos",
      "Private online gallery",
      "Print-ready files",
    ],
  },
  {
    title: "Full Session",
    price: "£300",
    duration: "1 hour",
    features: [
      "80+ digital images",
      "Fully edited photos",
      "Private online gallery",
      "Print-ready files",
      "Location of your choice within my coverage area",
    ],
    featured: true,
  },
  {
    title: "Event Coverage",
    price: "£300",
    duration: "per hour",
    features: [
      "80+ digital images per hour",
      "Fully edited photos",
      "Private online gallery",
      "Print-ready files",
      "Quick turnaround",
      "Flexible duration",
    ],
  },
];

const portfolioItems = [
  {
    title: "Family",
    image:
      "https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/family/010-Web.jpg",
    href: "/portfolio/family/",
    category: "Portfolio",
  },
  {
    title: "Maternity",
    image:
      "https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/maternity/003-Web-e1731516397349.jpg",
    href: "/portfolio/maternity/",
    category: "Portfolio",
  },
  {
    title: "Couples",
    image:
      "https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/love/DSCF9849.webp",
    href: "/portfolio/love/",
    category: "Portfolio",
  },
  {
    title: "Children",
    image:
      "https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/children/082-Web.jpg",
    href: "/portfolio/children/",
    category: "Portfolio",
  },
  {
    title: "Events",
    image:
      "https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/115-Web.jpg",
    href: "/portfolio/events/",
    category: "Portfolio",
  },
];

const testimonials = [
  {
    quote:
      "Gaby captured our family beautifully. The photos exceeded our expectations and we will treasure them forever.",
    name: "Sarah M.",
    rating: 5,
  },
  {
    quote:
      "Such a lovely experience! Gaby made us feel so comfortable and the results are stunning.",
    name: "Emma T.",
    rating: 5,
  },
  {
    quote:
      "Professional, creative, and so patient with our little ones. Highly recommend MellSnap!",
    name: "James & Lisa",
    rating: 5,
  },
];
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <Hero
    title="Natural Outdoor Family Photography"
    subtitle="Family Photographer in Kingston upon Thames & London"
    ctaText="Book Your Session"
    ctaLink="/free-consultation/"
  />

  <!-- Portfolio Preview Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Explore and experience natural photo sessions</p>
        <h2 class="font-cormorant text-4xl md:text-5xl text-primary-text">
          My Family & Lifestyle Photography Portfolio
        </h2>
      </div>

      <PortfolioCarousel items={portfolioItems} />

      <div class="text-center mt-12">
        <Button href="/portfolio/" variant="secondary">
          View Full Portfolio
        </Button>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Services</p>
        <h2 class="font-cormorant text-4xl md:text-5xl text-primary-text">
          Photography Packages
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              price={service.price}
              duration={service.duration}
              features={service.features}
              featured={service.featured}
            />
          ))
        }
      </div>

      <div class="text-center mt-12">
        <Button href="/services/" variant="secondary">
          View All Services
        </Button>
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <p class="label mb-4">About me</p>
        <h2 class="font-cormorant text-4xl md:text-5xl text-primary-text mb-8">
          Hello, I'm Gaby
        </h2>
        <p
          class="font-cormorant text-xl md:text-2xl text-secondary-text leading-relaxed mb-10"
        >
          I'm a family and portrait photographer based in Kingston upon Thames,
          serving South West and Central London. I believe in capturing
          authentic moments that tell your unique story. Every family is
          different, and I love creating images that reflect the genuine
          connections and joy in your lives.
        </p>
        <Button href="/about/" variant="secondary">
          Learn More About Me
        </Button>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Testimonials</p>
        <h2 class="font-cormorant text-4xl md:text-5xl text-primary-text">
          What Clients Say
        </h2>
        <p class="font-cormorant text-xl text-secondary-text mt-4">
          5.0 rating from <a
            class="hover:underline text-pink"
            href="https://share.google/KYxFW8GJmiGjTPqWG"
            target="_blank"
            rel="noopener noreferrer">33 Google reviews</a
          >
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {
          testimonials.map((testimonial) => (
            <TestimonialCard
              quote={testimonial.quote}
              name={testimonial.name}
              rating={testimonial.rating}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <img
      src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/family/010-Web.jpg"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-cormorant text-4xl md:text-5xl text-white mb-6">
          Ready to Capture Your Story?
        </h2>
        <p class="font-cormorant text-xl text-white/90 mb-10">
          Let's create beautiful memories together. Book your session today.
        </p>
        <a class="btn bg-green text-white hover:bg-green-500" href="/free-consultation/"> Get in Touch </a>
      </div>
    </div>
  </section>
</BaseLayout>
