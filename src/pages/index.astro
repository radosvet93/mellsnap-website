---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PortfolioCard from "../components/PortfolioCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import Button from "../components/Button.astro";

const services = [
  {
    title: "Quick Session",
    price: "£180",
    duration: "20 minutes",
    features: [
      "30+ digital images",
      "Fully edited photos",
      "Private online gallery",
      "Print-ready files",
    ],
  },
  {
    title: "Full Session",
    price: "£300",
    duration: "1 hour",
    features: [
      "80+ digital images",
      "Fully edited photos",
      "Private online gallery",
      "Print-ready files",
      "Location of your choice within my coverage area",
    ],
    featured: true,
  },
  {
    title: "Event Coverage",
    price: "£300",
    duration: "per hour",
    features: [
      "80+ digital images per hour",
      "Fully edited photos",
      "Private online gallery",
      "Print-ready files",
      "Quick turnaround",
      "Flexible duration",
    ],
  },
];

const portfolioItems = [
  {
    title: "Family",
    image:
      "https://images.unsplash.com/photo-1609220136736-443140cffec6?w=600&h=750&fit=crop",
    href: "/portfolio/family/",
    category: "Portfolio",
  },
  {
    title: "Maternity",
    image:
      "https://images.unsplash.com/photo-1544126592-807ade215a0b?w=600&h=750&fit=crop",
    href: "/portfolio/maternity/",
    category: "Portfolio",
  },
  {
    title: "Love",
    image:
      "https://images.unsplash.com/photo-1522673607200-164d1b6ce486?w=600&h=750&fit=crop",
    href: "/portfolio/love/",
    category: "Portfolio",
  },
];

const testimonials = [
  {
    quote:
      "Gaby captured our family beautifully. The photos exceeded our expectations and we will treasure them forever.",
    name: "Sarah M.",
    rating: 5,
  },
  {
    quote:
      "Such a lovely experience! Gaby made us feel so comfortable and the results are stunning.",
    name: "Emma T.",
    rating: 5,
  },
  {
    quote:
      "Professional, creative, and so patient with our little ones. Highly recommend MellSnap!",
    name: "James & Lisa",
    rating: 5,
  },
];
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <Hero
    title="Capturing Your Precious Moments"
    subtitle="Family & Portrait Photography"
    image="https://images.unsplash.com/photo-1609220136736-443140cffec6?w=1920&h=1080&fit=crop"
    ctaText="Book Your Session"
    ctaLink="/contact/"
  />

  <!-- Portfolio Preview Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Portfolio</p>
        <h2 class="font-cormorant text-4xl md:text-5xl text-primary-text">
          Recent Work
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {
          portfolioItems.map((item) => (
            <PortfolioCard
              title={item.title}
              image={item.image}
              href={item.href}
              category={item.category}
            />
          ))
        }
      </div>

      <div class="text-center mt-12">
        <Button href="/portfolio/" variant="secondary">
          View Full Portfolio
        </Button>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Services</p>
        <h2 class="font-cormorant text-4xl md:text-5xl text-primary-text">
          Photography Packages
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              price={service.price}
              duration={service.duration}
              features={service.features}
              featured={service.featured}
            />
          ))
        }
      </div>

      <div class="text-center mt-12">
        <Button href="/services/" variant="secondary">
          View All Services
        </Button>
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <p class="label mb-4">About me</p>
        <h2 class="font-cormorant text-4xl md:text-5xl text-primary-text mb-8">
          Hello, I'm Gaby
        </h2>
        <p
          class="font-cormorant text-xl md:text-2xl text-secondary-text leading-relaxed mb-10"
        >
          I'm a family and portrait photographer based in Kingston upon Thames,
          serving South West and Central London. I believe in capturing
          authentic moments that tell your unique story. Every family is
          different, and I love creating images that reflect the genuine
          connections and joy in your lives.
        </p>
        <Button href="/about/" variant="secondary">
          Learn More About Me
        </Button>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Testimonials</p>
        <h2 class="font-cormorant text-4xl md:text-5xl text-primary-text">
          What Clients Say
        </h2>
        <p class="font-cormorant text-xl text-secondary-text mt-4">
          5.0 rating from 33 Google reviews
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {
          testimonials.map((testimonial) => (
            <TestimonialCard
              quote={testimonial.quote}
              name={testimonial.name}
              rating={testimonial.rating}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 md:py-28 bg-beige">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-cormorant text-4xl md:text-5xl text-primary-text mb-6">
          Ready to Capture Your Story?
        </h2>
        <p class="font-cormorant text-xl text-secondary-text mb-10">
          Let's create beautiful memories together. Book your session today.
        </p>
        <Button href="/contact/" variant="secondary"> Get in Touch </Button>
      </div>
    </div>
  </section>
</BaseLayout>
