---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PortfolioCarousel from "../components/PortfolioCarousel.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import GabyAndMeliImage from "../images/gaby-meli.png";
import { getCollection } from "astro:content";
import { fetchGoogleReviews } from "../data/googleReviews";

const services = [
  {
    title: "Quick Session",
    price: "£180",
    duration: "20 minutes",
    features: [
      "20+ digital images",
      "Fully edited photos",
      "Private online gallery",
      "Print-ready files",
    ],
    ctaLink: "/quick-photoshoot/",
  },
  {
    title: "Full Session",
    price: "£300",
    duration: "1 hour",
    features: [
      "80+ digital images",
      "Fully edited photos",
      "Private online gallery",
      "Print-ready files",
      "Location of your choice within my coverage area",
    ],
    featured: true,
    ctaLink: "/full-photoshoot/",
  },
  {
    title: "Event Coverage",
    price: "£300",
    duration: "per hour",
    features: [
      "80+ digital images per hour",
      "Fully edited photos",
      "Private online gallery",
      "Print-ready files",
      "Quick turnaround",
      "Flexible duration",
    ],
    ctaLink: "/event-photography/",
  },
];

const portfolioItems = [
  {
    title: "Family",
    image:
      "https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/family/010-Web.jpg",
    href: "/portfolio/family/",
    category: "Portfolio",
  },
  {
    title: "Maternity",
    image:
      "https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/maternity/003-Web-e1731516397349.jpg",
    href: "/portfolio/maternity/",
    category: "Portfolio",
  },
  {
    title: "Couples",
    image:
      "https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/love/DSCF9849.webp",
    href: "/portfolio/love/",
    category: "Portfolio",
  },
  {
    title: "Children",
    image:
      "https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/children/082-Web.jpg",
    href: "/portfolio/children/",
    category: "Portfolio",
  },
  {
    title: "Events",
    image:
      "https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/115-Web.jpg",
    href: "/portfolio/events/",
    category: "Portfolio",
  },
];

const reviewStats = await fetchGoogleReviews();
const testimonials = await getCollection("reviews");
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <Hero
    title="Natural Outdoor Family Photography"
    subtitle="Family Photographer in Kingston upon Thames & London"
    ctaText="Book Your Session"
    ctaLink="/free-consultation/"
  />

  <!-- Portfolio Preview Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Real moments, no posing required</p>
        <h2 class="text-4xl md:text-5xl text-primary-text">
          My Family & Lifestyle Photography Portfolio
        </h2>
      </div>

      <PortfolioCarousel items={portfolioItems} />

      <div class="text-center mt-12">
        <Button href="/portfolio/" variant="secondary">
          View Full Portfolio
        </Button>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Services</p>
        <h2 class="text-primary-text">Photography Packages</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              price={service.price}
              duration={service.duration}
              features={service.features}
              featured={service.featured}
              ctaLink={service.ctaLink}
            />
          ))
        }
      </div>

      <div class="text-center mt-12">
        <Button href="/services/" variant="secondary">
          View All Services
        </Button>
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div class="">
          <Image
            src={GabyAndMeliImage}
            alt="Mother and daughter smiling and hugging each other"
            class="w-2/3 md:min-w-xs mx-auto h-auto pt-6 px-6 pb-16 shadow-lg overflow-hidden"
            loading="lazy"
          />
        </div>
        <div class="md:text-left text-center">
          <div class="mb-12">
            <p class="label mb-4">About me</p>
            <h2 class="text-4xl md:text-5xl text-primary-text mb-8">
              Hello, I'm Gaby
            </h2>
          </div>
          <p class="text-secondary-text leading-relaxed mb-10">
            I'm a family and portrait photographer based in Kingston upon
            Thames, serving South West and Central London. I believe in
            capturing authentic moments that tell your unique story. Every
            family is different, and I love creating images that reflect the
            genuine connections and joy in your lives.
          </p>

          <Button href="/about/" variant="secondary">
            Learn More About Me
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Testimonials</p>
        <h2 class="text-4xl md:text-5xl text-primary-text">What Clients Say</h2>
        <p class="text-secondary-text mt-4">
          {reviewStats.averageRating.toFixed(1)} rating from <a
            class="text-pink underline hover:text-light-pink"
            href="https://share.google/KYxFW8GJmiGjTPqWG"
            target="_blank"
            rel="noopener noreferrer"
            >{reviewStats.totalReviews} Google reviews</a
          >
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {
          testimonials.map((testimonial) => (
            <TestimonialCard
              quote={testimonial.data.quote}
              name={testimonial.data.name}
              rating={testimonial.data.rating}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">FAQ</p>
        <h2 class="text-4xl md:text-5xl text-primary-text">
          Frequently Asked Questions
        </h2>
      </div>

      <div class="max-w-3xl mx-auto divide-y divide-grey-200">
        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer list-none font-cormorant text-lg font-semibold text-primary-text">
            Which photo package is for me?
            <svg class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M224 416c-8.188 0-16.38-3.125-22.62-9.375l-192-192c-12.5-12.5-12.5-32.75 0-45.25s32.75-12.5 45.25 0L224 338.8l169.4-169.4c12.5-12.5 32.75-12.5 45.25 0s12.5 32.75 0 45.25l-192 192C240.4 412.9 232.2 416 224 416z"/></svg>
          </summary>
          <p class="mt-3 text-secondary-text">You can book a 10-minute free consultation with me and we are going to discuss the best package, as well as all the questions that you might have.</p>
        </details>

        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer list-none font-cormorant text-lg font-semibold text-primary-text">
            How long does it take to receive my images?
            <svg class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M224 416c-8.188 0-16.38-3.125-22.62-9.375l-192-192c-12.5-12.5-12.5-32.75 0-45.25s32.75-12.5 45.25 0L224 338.8l169.4-169.4c12.5-12.5 32.75-12.5 45.25 0s12.5 32.75 0 45.25l-192 192C240.4 412.9 232.2 416 224 416z"/></svg>
          </summary>
          <p class="mt-3 text-secondary-text">I try to retouch and process the images as soon as possible, normally it takes from 3 to 5 days for a mini session and from 5 to 10 days for a full session and events.</p>
        </details>

        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer list-none font-cormorant text-lg font-semibold text-primary-text">
            Do you have a photo studio?
            <svg class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M224 416c-8.188 0-16.38-3.125-22.62-9.375l-192-192c-12.5-12.5-12.5-32.75 0-45.25s32.75-12.5 45.25 0L224 338.8l169.4-169.4c12.5-12.5 32.75-12.5 45.25 0s12.5 32.75 0 45.25l-192 192C240.4 412.9 232.2 416 224 416z"/></svg>
          </summary>
          <p class="mt-3 text-secondary-text">While I may offer a studio option in the future, right now I specialise in outdoor sessions, where nature provides a beautiful, relaxed backdrop. Photographing families outside allows everyone to feel more comfortable and natural, so I can capture genuine connection, real smiles, and authentic moments that truly reflect your family.</p>
        </details>

        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer list-none font-cormorant text-lg font-semibold text-primary-text">
            What if it is raining?
            <svg class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M224 416c-8.188 0-16.38-3.125-22.62-9.375l-192-192c-12.5-12.5-12.5-32.75 0-45.25s32.75-12.5 45.25 0L224 338.8l169.4-169.4c12.5-12.5 32.75-12.5 45.25 0s12.5 32.75 0 45.25l-192 192C240.4 412.9 232.2 416 224 416z"/></svg>
          </summary>
          <p class="mt-3 text-secondary-text">We can reschedule for more sunny days, and you won't lose anything—I don't require a booking fee!</p>
        </details>

        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer list-none font-cormorant text-lg font-semibold text-primary-text">
            How will I get my images?
            <svg class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M224 416c-8.188 0-16.38-3.125-22.62-9.375l-192-192c-12.5-12.5-12.5-32.75 0-45.25s32.75-12.5 45.25 0L224 338.8l169.4-169.4c12.5-12.5 32.75-12.5 45.25 0s12.5 32.75 0 45.25l-192 192C240.4 412.9 232.2 416 224 416z"/></svg>
          </summary>
          <p class="mt-3 text-secondary-text">I'll send you a secure link from where you can download all the digital images whenever they are ready, they will be in two formats. One optimised for social media sharing and one for printing.</p>
        </details>

        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer list-none font-cormorant text-lg font-semibold text-primary-text">
            Will my photos be used for your blog or marketing?
            <svg class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M224 416c-8.188 0-16.38-3.125-22.62-9.375l-192-192c-12.5-12.5-12.5-32.75 0-45.25s32.75-12.5 45.25 0L224 338.8l169.4-169.4c12.5-12.5 32.75-12.5 45.25 0s12.5 32.75 0 45.25l-192 192C240.4 412.9 232.2 416 224 416z"/></svg>
          </summary>
          <p class="mt-3 text-secondary-text">I might use a few photos from our session on my blog or in marketing to help others discover my work, much like how you found me. Showcasing real photo sessions is key to reaching new clients. Let me know if you'd prefer not to have your photos featured!</p>
        </details>

        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer list-none font-cormorant text-lg font-semibold text-primary-text">
            How to book a photo session?
            <svg class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M224 416c-8.188 0-16.38-3.125-22.62-9.375l-192-192c-12.5-12.5-12.5-32.75 0-45.25s32.75-12.5 45.25 0L224 338.8l169.4-169.4c12.5-12.5 32.75-12.5 45.25 0s12.5 32.75 0 45.25l-192 192C240.4 412.9 232.2 416 224 416z"/></svg>
          </summary>
          <p class="mt-3 text-secondary-text">Booking a session is very easy, you can either click the button for a free 10-minute consultation with me on which we are going to discuss everything and reserve a date, alternatively, you can fill in the contact form or just call me, check the <a href="/contact/" class="underline">contact page</a> for more details.</p>
        </details>

        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer list-none font-cormorant text-lg font-semibold text-primary-text">
            When is payment required?
            <svg class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M224 416c-8.188 0-16.38-3.125-22.62-9.375l-192-192c-12.5-12.5-12.5-32.75 0-45.25s32.75-12.5 45.25 0L224 338.8l169.4-169.4c12.5-12.5 32.75-12.5 45.25 0s12.5 32.75 0 45.25l-192 192C240.4 412.9 232.2 416 224 416z"/></svg>
          </summary>
          <p class="mt-3 text-secondary-text">I don't have a booking fee and all packages include all digital images. The payment can be done in various stages, on the session or just before you receive your images, whenever suits you best. I accept card and cash payments.</p>
        </details>

        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer list-none font-cormorant text-lg font-semibold text-primary-text">
            Are you doing photo prints?
            <svg class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M224 416c-8.188 0-16.38-3.125-22.62-9.375l-192-192c-12.5-12.5-12.5-32.75 0-45.25s32.75-12.5 45.25 0L224 338.8l169.4-169.4c12.5-12.5 32.75-12.5 45.25 0s12.5 32.75 0 45.25l-192 192C240.4 412.9 232.2 416 224 416z"/></svg>
          </summary>
          <p class="mt-3 text-secondary-text">No, not at the moment, but I'm able to help with printing information and good companies that do print, just let me know.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <Image
      inferSize
      src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/family/010-Web.jpg"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-ephesis! text-3xl md:text-4xl lg:text-5xl text-white mb-6">
          Ready to Capture Your Story?
        </h2>
        <p class="text-white/90 mb-10">
          Let's create beautiful memories together. Book your session today.
        </p>
        <a
          class="btn bg-green text-white hover:bg-green-500"
          href="/free-consultation/"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
