---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import HeroIntro from "../components/HeroIntro.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PortfolioShowcase from "../components/PortfolioShowcase.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import Button from "../components/Button.astro";
import FaqSection from "../components/FaqSection.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { Image } from "astro:assets";
import whyChooseImage from "../images/couple-garden-embrace.jpg";
import { getCollection } from "astro:content";
import { fetchGoogleReviews } from "../data/googleReviews";
import { services } from "../data/services";

const portfolioItems = [
  {
    title: "Family",
    image: {
      src: "https://images.mellsnap.co.uk/file/mellsnap-website/138-Web.jpg",
      alt: "Two mothers and their children smiling and looking at each other",
    },
    href: "/portfolio/family/",
  },
  {
    title: "Maternity",
    image: {
      src: "https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/maternity/003-Web-e1731516397349.jpg",
      alt: "Pregnant woman holding her belly and smiling",
    },
    href: "/portfolio/maternity/",
  },
  {
    title: "Couples",
    image: {
      src: "https://images.mellsnap.co.uk/file/mellsnap-website/1021-Web.jpg",
      alt: "A couple at a wedding day looking at each other and smiling",
    },
    href: "/portfolio/love/",
  },
  {
    title: "Children",
    image: {
      src: "https://images.mellsnap.co.uk/file/mellsnap-website/015-Web.jpg",
      alt: "Two sisters looking at each other in-front of the Tower Bridge in London",
    },
    href: "/portfolio/children/",
  },
  {
    title: "Events",
    image: {
      src: "https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/115-Web.jpg",
      alt: "A pink birthday cake in-front of a let's party banner and balloons",
    },
    href: "/portfolio/events/",
  },
];

const reviewStats = await fetchGoogleReviews();
const testimonials = await getCollection("reviews");

const faqs = [
  {
    question: "Which photo package is for me?",
    answer:
      "You can book a 10-minute free consultation and we will discuss the best package, as well as all the questions that you might have.",
    answerHtml: `You can book a <a href="/free-consultation/" class="hover:text-pink transition-colors underline underline-offset-2">10-minute free consultation</a> with me and we are going to discuss the best package, as well as all the questions that you might have.`,
  },
  {
    question: "How long does it take to receive my images?",
    answer:
      "I try to retouch and process the images as soon as possible, normally it takes 3 to 5 days for a quick session and 7 to 10 days for a full session or event.",
  },
  {
    question: "Do you have a photo studio?",
    answer:
      "While I may offer a studio option in the future, right now I specialise in outdoor sessions, where nature provides a beautiful, relaxed backdrop. Photographing families outside allows everyone to feel more comfortable and natural, so I can capture genuine connection, real smiles, and authentic moments that truly reflect your family.",
  },
  {
    question: "What if it is raining?",
    answer:
      "We can reschedule for more sunny days, and you won't lose anything—I don't require a booking fee!",
  },
  {
    question: "How will I get my images?",
    answer:
      "I'll send you a secure link from where you can download all the digital images whenever they are ready, they will be in two formats. One optimised for social media sharing and one for printing.",
  },
  {
    question: "Will my photos be used for your blog or marketing?",
    answer:
      "I might use a few photos from our session on my blog or in marketing to help others discover my work, much like how you found me. Showcasing real photo sessions is key to reaching new clients. Let me know if you'd prefer not to have your photos featured!",
  },
  {
    question: "How to book a photo session?",
    answer:
      "Booking a session is very easy, you can either book a free 10-minute consultation with me to discuss everything and reserve a date, alternatively, you can fill in the contact form or just call me.",
    answerHtml: `Booking a session is very easy, you can either click the button for a <a href="/free-consultation/" class="hover:text-pink transition-colors underline underline-offset-2">free 10-minute consultation</a> with me on which we are going to discuss everything and reserve a date, alternatively, you can fill in the contact form or just call me, check the <a href="/contact/" class="hover:text-pink transition-colors underline underline-offset-2">contact page</a> for more details.`,
  },
  {
    question: "When is payment required?",
    answer:
      "I don't have a booking fee and all packages include all digital images. The payment can be done in various stages, on the session or just before you receive your images, whenever suits you best. I accept card and cash payments.",
  },
  {
    question: "Are you doing photo prints?",
    answer:
      "No, not at the moment, but I'm able to help with printing information and good companies that do print, just let me know.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": "https://mellsnap.co.uk/#business",
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: String(reviewStats.averageRating),
        reviewCount: String(reviewStats.totalReviews),
      },
    },
    {
      "@type": "WebSite",
      "@id": "https://mellsnap.co.uk/#website",
      name: "MellSnap Photography",
      url: "https://mellsnap.co.uk",
      publisher: { "@id": "https://mellsnap.co.uk/#business" },
    },
    {
      "@type": "Person",
      "@id": "https://mellsnap.co.uk/#gaby",
      name: "Gaby",
      jobTitle: "Family & Lifestyle Photographer",
      worksFor: { "@id": "https://mellsnap.co.uk/#business" },
      url: "https://mellsnap.co.uk/about/",
      sameAs: [
        "https://instagram.com/mellsnap",
        "https://facebook.com/mellphotosnap",
        "https://pinterest.com/mellsnap",
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://mellsnap.co.uk/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title="Family Photographer Kingston upon Thames | MellSnap"
  description="Natural, relaxed outdoor photos of families, mums-to-be, couples and events in Kingston upon Thames and London. 5-star rated. Book a free consultation."
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd, null, 2)}
  />
  <!-- Hero Section -->
  <Hero />

  <!-- Intro Section -->
  <HeroIntro
    greeting="Hello, I'm Gaby"
    title="Family Photographer in Kingston upon Thames & London"
    intro="I take natural, candid photos of families, mums-to-be and couples, and I also photograph birthdays and special events across Kingston and London. Every photoshoot is unique, and I focus on capturing the love, connection and emotion between you, along with all the small details and in-between moments."
    ctaText="Book a Free Consultation"
    ctaLink="/free-consultation/"
    secondaryCtaText="View My Portfolio"
    secondaryCtaLink="/portfolio/"
    rating={reviewStats.averageRating}
    reviewCount={reviewStats.totalReviews}
    reviewsLink="https://share.google/KYxFW8GJmiGjTPqWG"
    areas="I photograph families across Kingston, Richmond, Wimbledon, Twickenham, Teddington, Surbiton and Central London."
  />

  <!-- Portfolio Preview Section -->
  <section class="py-20 md:py-28 bg-linen">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Explore and View my Photography Work</p>
        <h2 class="text-4xl md:text-5xl text-primary-text">
          Family & Lifestyle Photography Portfolio
        </h2>
      </div>

      <PortfolioShowcase items={portfolioItems} />

      <div class="text-center mt-12">
        <Button href="/portfolio/" variant="secondary">
          View Full Portfolio
        </Button>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-32 bg-white overflow-hidden">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-6 items-center">
        <!-- Text content -->
        <div
          class="md:pl-6 lg:pl-10 pt-10 md:pt-0 pb-10 md:pb-0 text-center md:text-left"
        >
          <p class="label mb-4">Why Choose MellSnap</p>
          <h2
            class="font-cormorant text-4xl md:text-5xl text-primary-text leading-tight mb-6"
          >
            No posing.<br />
            <span class="italic text-pink">Just real moments.</span>
          </h2>

          <div class="w-12 h-px bg-pink/50 mb-6 mx-auto md:mx-0"></div>

          <p class="text-secondary-text leading-relaxed mb-5">
            Photography with me feels more like a relaxed walk than a formal
            photo shoot. I gently guide you when needed, while creating space
            for natural, beautiful moments to unfold. I try to make the
            experience as simple and stress-free from start to finish.
          </p>
          <p class="text-secondary-text leading-relaxed mb-8">
            Children can simply be themselves, playful, curious, full of life,
            and that's exactly what I capture. You receive all successful images
            in a private online gallery, beautifully edited and included without
            any extra fees.
          </p>

          <Button href="/free-consultation/" variant="primary">
            Book a Free Consultation
          </Button>
        </div>

        <!-- Image -->
        <div class="flex justify-center md:justify-end">
          <Image
            src={whyChooseImage}
            widths={[480, 800]}
            sizes="(min-width: 768px) 40vw, 90vw"
            alt="Couple in a gentle embrace on a garden path surrounded by pink and white azaleas"
            class="w-full max-w-sm lg:max-w-md aspect-4/5 object-cover border-8 border-white shadow-xl object-[center_65%]"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 md:py-28 bg-linen">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Services</p>
        <h2 class="text-primary-text">Photography Packages</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto items-stretch">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              price={service.price}
              duration={service.duration}
              features={service.features}
              image={service.image}
              featured={service.featured}
              ctaLink={service.ctaLink}
            />
          ))
        }
      </div>

      <div class="text-center mt-12">
        <Button href="/services/" variant="secondary">
          View All Services
        </Button>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Testimonials</p>
        <h2 class="text-4xl md:text-5xl text-primary-text">What Clients Say</h2>
        <p class="text-secondary-text mt-4">
          {reviewStats.averageRating.toFixed(1)} rating from <a
            class="hover:text-pink transition-colors underline underline-offset-2"
            href="https://share.google/KYxFW8GJmiGjTPqWG"
            target="_blank"
            rel="noopener noreferrer"
            >{reviewStats.totalReviews} Google reviews</a
          >
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {
          testimonials.map((testimonial) => (
            <TestimonialCard
              quote={testimonial.data.quote}
              name={testimonial.data.name}
              rating={testimonial.data.rating}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FaqSection faqs={faqs} />

  <!-- CTA Section -->
  <CtaBanner
    title="Ready to Capture Your Story?"
    text="Let's create beautiful memories together. Book your session today."
  />
</BaseLayout>
