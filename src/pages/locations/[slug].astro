---
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";

const locationImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../images/locations/*.{jpg,jpeg,png,webp}",
);

const SITE_URL = import.meta.env.SITE ?? "https://mellsnap.co.uk";

export async function getStaticPaths() {
  const locations = await getCollection("locations");
  return locations.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      nearby: locations.filter((loc) =>
        entry.data.nearbyLocations.includes(loc.id),
      ),
    },
  }));
}

const { entry, nearby } = Astro.props;
const { Content } = await render(entry);
const {
  name,
  tagline,
  heroImage,
  practicalInfo,
  galleryImages,
  faqs,
  shootTypes,
  seasons,
  vibes,
  map,
} = entry.data;

const capitalize = (s: string) =>
  s.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

const parkingIsFree = practicalInfo.parking.toLowerCase().includes("free");

const heroImageKey = `../../images/locations/${heroImage}`;
const heroImageMod = await locationImages[heroImageKey]?.();
const heroImageSrc = heroImageMod?.default;
const optimizedHero = heroImageSrc
  ? await getImage({ src: heroImageSrc, format: "webp", quality: 85 })
  : null;

const pageDescription = `${name} is one of South West London's best photoshoot locations. Family, maternity and couples photography with MellSnap — book your free consultation today.`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  name,
  description: pageDescription,
  url: `${SITE_URL}/locations/${entry.id}`,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
    {
      "@type": "ListItem",
      position: 2,
      name: "Location Finder",
      item: `${SITE_URL}/tools/location-finder`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name,
      item: `${SITE_URL}/locations/${entry.id}`,
    },
  ],
};
---

<BaseLayout
  title={`${name} Photoshoot London`}
  description={pageDescription}
  ogImage={optimizedHero?.src}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(placeSchema)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>

  <!-- Hero -->
  <section class="relative h-[70vh] min-h-120 bg-section-bg overflow-hidden">
    <Image
      src={heroImageSrc}
      alt={`${name} photoshoot location`}
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      widths={[800, 1200, 1920]}
      sizes="100vw"
      format="webp"
      quality={85}
    />

    <div class="absolute inset-0 bg-linear-to-b from-black/60 to-black/20">
    </div>
    <div
      class="relative z-10 h-full flex flex-col items-center justify-center text-center px-4"
    >
      <nav
        aria-label="Breadcrumb"
        class="text-white text-sm mb-6 font-raleway tracking-widest uppercase"
      >
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a
          href="/tools/location-finder"
          class="hover:text-white transition-colors">Locations</a
        >
        <span class="mx-2">/</span>
        <span class="text-white/90">{name}</span>
      </nav>
      <h1
        class="text-5xl md:text-7xl text-white font-cormorant font-semibold mb-4 leading-tight"
      >
        {name}
      </h1>
      <div class="w-12 h-px bg-white/50 mb-4 mx-auto"></div>
      <p
        class="text-white/85 text-lg md:text-xl font-lora italic mb-10 max-w-xl"
      >
        {tagline}
      </p>
      <Button href="/free-consultation" variant="primary"
        >Book Free Consultation</Button
      >
    </div>
  </section>

  <!-- Why this location -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <p class="label mb-4">About This Location</p>
      <h2 class="text-primary-text mb-10">Why {name}?</h2>
      <div class="grid lg:grid-cols-[1fr_360px] gap-12 items-start">
        <!-- Prose -->
        <div
          class="location-prose font-lora text-secondary-text leading-relaxed space-y-5"
        >
          <Content />
        </div>

        <!-- Quick facts sidebar -->
        <aside
          class="border border-light-pink rounded-sm p-6 space-y-6 sticky top-8"
        >
          <h3 class="font-cormorant text-xl text-primary-text font-semibold">
            At a Glance
          </h3>
          <div class="w-8 h-px bg-pink/40"></div>

          <div>
            <p class="label mb-3">Vibes</p>
            <div class="flex flex-wrap gap-2">
              {
                vibes.map((v) => (
                  <span class="inline-block bg-pink text-white font-raleway text-xs tracking-wide px-3 py-1 rounded-full">
                    {capitalize(v)}
                  </span>
                ))
              }
            </div>
          </div>

          <div>
            <p class="label mb-3">Shoot Types</p>
            <div class="flex flex-wrap gap-2">
              {
                shootTypes.map((t) => (
                  <span class="inline-block bg-section-bg text-secondary-text font-raleway text-xs tracking-wide px-3 py-1 rounded-full border border-light-pink">
                    {capitalize(t)}
                  </span>
                ))
              }
            </div>
          </div>

          <div>
            <p class="label mb-3">Seasons</p>
            <div class="flex flex-wrap gap-2">
              {
                seasons.map((s) => (
                  <span class="inline-block bg-section-bg text-secondary-text font-raleway text-xs tracking-wide px-3 py-1 rounded-full border border-light-pink">
                    {capitalize(s)}
                  </span>
                ))
              }
            </div>
          </div>

          <div class="pt-2 border-t border-light-pink">
            <a
              href="/free-consultation"
              class="block text-center btn btn-primary text-xs w-full"
            >
              Book Here
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <style>
    .location-prose :global(p:first-of-type::first-letter) {
      font-family: var(--font-cormorant);
      font-size: 3.5rem;
      font-weight: 600;
      line-height: 0.8;
      float: left;
      margin-right: 0.1em;
      margin-top: 0.05em;
      color: var(--color-pink);
    }
  </style>

  <!-- Practical Info -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <p class="label mb-4">Plan Your Visit</p>
        <h2 class="text-primary-text mb-10">Practical Information</h2>
        <dl class="space-y-4">
          <!-- Parking -->
          <div class="bg-white rounded-sm p-6 flex gap-5 items-start">
            <div
              class="shrink-0 w-10 h-10 rounded-full bg-beige flex items-center justify-center text-pink"
            >
              <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M9.5 7.5h3a2.5 2.5 0 010 5H9.5V7.5z"></path>
                <path d="M9.5 12.5v4"></path>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-3 mb-2 flex-wrap">
                <dt class="label">Parking</dt>
                {
                  parkingIsFree && (
                    <span class="inline-block bg-green/10 text-green font-raleway text-xs font-semibold tracking-wider px-2 py-0.5 rounded-full border border-green/20">
                      Free
                    </span>
                  )
                }
              </div>
              <dd class="text-secondary-text font-lora leading-relaxed text-sm">
                {practicalInfo.parking}
              </dd>
            </div>
          </div>

          <!-- Transport -->
          <div class="bg-white rounded-sm p-6 flex gap-5 items-start">
            <div
              class="shrink-0 w-10 h-10 rounded-full bg-beige flex items-center justify-center text-pink"
            >
              <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="5" y="3" width="14" height="13" rx="2"></rect>
                <path d="M5 10h14"></path>
                <path d="M9 17l-2 4M15 17l2 4"></path>
                <circle
                  cx="8.5"
                  cy="14.5"
                  r="1"
                  fill="currentColor"
                  stroke="none"></circle>
                <circle
                  cx="15.5"
                  cy="14.5"
                  r="1"
                  fill="currentColor"
                  stroke="none"></circle>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <dt class="label mb-2">Getting There</dt>
              <dd class="text-secondary-text font-lora leading-relaxed text-sm">
                {practicalInfo.transport}
              </dd>
            </div>
          </div>

          <!-- Best time -->
          <div class="bg-white rounded-sm p-6 flex gap-5 items-start">
            <div
              class="shrink-0 w-10 h-10 rounded-full bg-beige flex items-center justify-center text-pink"
            >
              <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v5l3 3"></path>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <dt class="label mb-2">Best Time to Visit</dt>
              <dd class="text-secondary-text font-lora leading-relaxed text-sm">
                {practicalInfo.bestTime}
              </dd>
            </div>
          </div>

          <!-- Permits (optional) -->
          {
            practicalInfo.permits && (
              <div class="bg-white rounded-sm p-6 flex gap-5 items-start">
                <div class="shrink-0 w-10 h-10 rounded-full bg-beige flex items-center justify-center text-pink">
                  <svg
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 12h6m-6 4h6M7 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2h-2M9 3h6v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V3z" />
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <dt class="label mb-2">Permits</dt>
                  <dd class="text-secondary-text font-lora leading-relaxed text-sm">
                    {practicalInfo.permits}
                  </dd>
                </div>
              </div>
            )
          }

          <!-- Map -->
          {
            map && (
              <div class="flex-1 min-w-0">
                <div class="text-secondary-text font-lora leading-relaxed text-sm">
                  <iframe
                    src={map}
                    width="100%"
                    height="450"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                  />
                </div>
              </div>
            )
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  {
    galleryImages.length > 0 && (
      <section class="py-20 md:py-28 bg-white">
        <div class="container">
          <p class="label mb-4 text-center">Photography Here</p>
          <h2 class="text-primary-text mb-10 text-center">Gallery</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3 max-w-5xl mx-auto">
            {galleryImages.map((img) => (
              <div class="aspect-square overflow-hidden rounded-sm bg-section-bg img-hover">
                <Image
                  widths={[800, 1200, 1920]}
                  src={img}
                  alt={`${name} photoshoot location`}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  sizes="100vw"
                  inferSize
                  format="webp"
                  quality={85}
                />
              </div>
            ))}
          </div>
          <div class="mt-8 text-center">
            <a
              href="/portfolio"
              class="text-pink underline underline-offset-2 font-raleway text-sm tracking-widest uppercase hover:text-primary-text transition-colors"
            >
              See full portfolio →
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <p class="label mb-4">Questions & Answers</p>
        <h2 class="text-primary-text mb-10">Frequently Asked Questions</h2>
        <div class="divide-y divide-light-pink">
          {
            faqs.map((faq) => (
              <details class="group py-5">
                <summary class="flex justify-between items-center cursor-pointer list-none font-cormorant text-xl font-semibold text-primary-text">
                  {faq.q}
                  <svg
                    class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180 ml-4"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 448 512"
                  >
                    <path d="M224 416c-8.188 0-16.38-3.125-22.62-9.375l-192-192c-12.5-12.5-12.5-32.75 0-45.25s32.75-12.5 45.25 0L224 338.8l169.4-169.4c12.5-12.5 32.75-12.5 45.25 0s12.5 32.75 0 45.25l-192 192C240.4 412.9 232.2 416 224 416z" />
                  </svg>
                </summary>
                <p class="mt-3 text-secondary-text font-lora leading-relaxed">
                  {faq.a}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CTA with hero image background -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <Image
      src={heroImageSrc}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      widths={[800, 1200, 1920]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="lazy"
    />

    <div class="absolute inset-0 bg-black/70"></div>
    <div class="container relative z-10">
      <div class="max-w-xl mx-auto text-center">
        <h2
          class="font-ephesis! text-4xl md:text-5xl lg:text-6xl text-white mb-6"
        >
          Ready to shoot at {name}?
        </h2>
        <p class="text-white/85 font-lora mb-10">
          Book a free 15-minute consultation and we'll plan your perfect session
          together.
        </p>
        <a
          class="btn bg-green text-white hover:bg-green-500"
          href="/free-consultation/"
        >
          Book Free Consultation
        </a>
      </div>
    </div>
  </section>

  <!-- Nearby Locations -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      {
        nearby.length > 0 && (
          <>
            <p class="label mb-4 text-center">Explore More</p>
            <h2 class="text-primary-text mb-10 text-center">
              Nearby Locations
            </h2>
            <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 max-w-5xl mx-auto mb-10">
              {nearby.map((loc) => (
                <a
                  href={`/locations/${loc.id}`}
                  class="bg-white rounded-sm p-6 shadow-sm hover:shadow-md transition-shadow border-b-2 border-transparent hover:border-pink block"
                >
                  <h3 class=" text-primary-text font-cormorant text-2xl! mb-2">
                    {loc.data.name}
                  </h3>
                  <p class="text-sm text-secondary-text font-lora italic line-clamp-2">
                    {loc.data.tagline}
                  </p>
                </a>
              ))}
            </div>
          </>
        )
      }
      <div class="text-center">
        <a
          href="/tools/location-finder"
          class="text-pink underline underline-offset-2 font-raleway text-sm tracking-widest uppercase hover:text-primary-text transition-colors"
        >
          Explore all locations →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
