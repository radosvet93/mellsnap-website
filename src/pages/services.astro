---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";

const services = [
  {
    title: "Quick Session",
    price: "£180",
    duration: "20 minutes",
    features: [
      "20+ digital images",
      "Fully edited photos",
      "Private online gallery",
      "Print-ready files",
    ],
    ctaLink: "/quick-photoshoot/",
  },
  {
    title: "Full Session",
    price: "£300",
    duration: "1 hour",
    features: [
      "80+ digital images",
      "Fully edited photos",
      "Private online gallery",
      "Print-ready files",
      "Location of your choice within my coverage area",
    ],
    featured: true,
    ctaLink: "/full-photoshoot/",
  },
  {
    title: "Event Coverage",
    price: "£300",
    duration: "per hour",
    features: [
      "80+ digital images per hour",
      "Fully edited photos",
      "Private online gallery",
      "Print-ready files",
      "Quick turnaround",
      "Flexible duration",
    ],
    ctaLink: "/event-photography/",
  },
];
---

<BaseLayout
  title="Services"
  description="Photography packages and pricing. Quick sessions, full sessions, and event coverage available."
>
  <!-- Hero -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Services</p>
        <h1 class="text-primary-text">Photography Packages</h1>
        <p class="text-secondary-text mt-6 max-w-2xl mx-auto">
          Choose the perfect package for your needs. All sessions include
          professional editing and a private online gallery.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              price={service.price}
              duration={service.duration}
              features={service.features}
              featured={service.featured}
              ctaLink={service.ctaLink}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <p class="label mb-4">Details</p>
          <h2 class="text-primary-text">What's Included</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-8">
            <h3 class="text-primary-text mb-4">Before Your Session</h3>
            <ul class="space-y-3 text-secondary-text">
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Pre-session consultation
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Location & styling guidance
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                What to wear guide
              </li>
            </ul>
          </div>

          <div class="bg-white p-8">
            <h3 class="text-primary-text mb-4">After Your Session</h3>
            <ul class="space-y-3 text-secondary-text">
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Professional colour grading
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Private online gallery (2 weeks)
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                High-resolution digital downloads
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-16">
          <p class="label mb-4">FAQ</p>
          <h2 class="text-primary-text">Common Questions</h2>
        </div>

        <div class="space-y-8">
          <div>
            <h3 class="text-primary-text mb-2">How do I book a session?</h3>
            <p class="text-secondary-text">
              Simply fill out the contact form or email me directly. I'll get
              back to you within 24-48 hours to discuss your session and check
              availability.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-2">What should we wear?</h3>
            <p class="text-secondary-text">
              I provide a detailed style guide after booking. Generally, neutral
              colours and classic styles photograph beautifully and stand the
              test of time.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-2">
              When will we receive our photos?
            </h3>
            <p class="text-secondary-text">
              Your gallery will be ready within 2 weeks. Event photography may
              take slightly longer depending on the size of the event.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-2">What if it rains?</h3>
            <p class="text-secondary-text">
              We can either embrace it (umbrellas and wellies make great
              photos!) or reschedule to another date. I'm flexible and want you
              to be comfortable.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28 bg-beige">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-primary-text mb-6">Ready to Book?</h2>
        <p class="text-secondary-text mb-10">
          Get in touch to check availability and book your session.
        </p>
        <a
          class="btn bg-green text-white hover:bg-green-500"
          href="/free-consultation/"
        >
          Contact Me
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
