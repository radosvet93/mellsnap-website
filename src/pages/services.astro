---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { Image } from "astro:assets";
import serviceImage from "../images/IMG_0511.JPEG";
import { services } from "../data/services";
---

<BaseLayout
  title="Services"
  description="Photography packages and pricing. Quick sessions, full sessions, and event coverage available."
>
  <!-- Hero -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">Services</p>
        <h1 class="text-primary-text">Photography Packages</h1>
        <p class="text-secondary-text mt-6 max-w-2xl mx-auto">
          Choose the perfect package for your needs. All sessions include
          professional editing and a private online gallery.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              price={service.price}
              duration={service.duration}
              features={service.features}
              featured={service.featured}
              ctaLink={service.ctaLink}
              isGrey
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <p class="label mb-4">Details</p>
          <h2 class="text-primary-text">What's Included</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-8">
            <h3 class="text-primary-text mb-4">Before Your Session</h3>
            <ul class="space-y-3 text-secondary-text">
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Free 10 minute consultation
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Location & styling guidance
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                What to wear guide
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Any questions answered before your session
              </li>
            </ul>
          </div>

          <div class="bg-white p-8">
            <h3 class="text-primary-text mb-4">After Your Session</h3>
            <ul class="space-y-3 text-secondary-text">
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Professionally edited photos
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Private online gallery (all images included)
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Two formats included: high-res for printing and web-optimised for
                social media sharing
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <Image
      inferSize
      src={serviceImage}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2
          class="font-ephesis! text-3xl md:text-4xl lg:text-5xl text-white mb-6"
        >
          Ready to Book?
        </h2>
        <p class="text-white/90 mb-10">
          Get in touch to check availability and book your session.
        </p>
        <a
          class="btn bg-green text-white hover:bg-green-500"
          href="/free-consultation/"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
