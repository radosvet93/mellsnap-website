---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { services } from "../data/services";
import { Image } from "astro:assets";

const quickService = services.find((service) => service.id === "quick");
---

<BaseLayout
  title="Quick Photoshoot"
  description="Enjoy 20 minutes of natural, candid photography in one of the best outdoor locations in London and receive 20+ professionally retouched digital images."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-section-bg">
    <div class="flex flex-col md:flex-row md:min-h-screen">

      <!-- Content card (left, overlaps image on desktop) -->
      <div class="flex-none md:w-1/2 flex items-center py-16 px-8 md:pl-8 lg:pl-8 xl:pl-8 md:pr-0 relative z-10">
        <div class="bg-beige shadow-2xl p-8 md:p-10 lg:p-12 w-full md:translate-x-10">
          <p class="font-raleway text-xs uppercase tracking-widest mb-5">
            Photography Package
          </p>

          <h1 class="text-primary-text leading-none mb-6">
            Quick Photoshoot
          </h1>

          <p class="font-ephesis text-pink text-4xl mb-8 leading-none">
            in just 20 minutes
          </p>

          <p class="text-secondary-text font-cormorant text-xl italic mb-10 leading-relaxed">
            For families and individuals looking for a quick, professional
            photoshoot experience.
          </p>

          <div class="w-10 h-px bg-pink/40 mb-6"></div>

          <ul class="space-y-2.5 mb-8">
            {
              quickService?.features.map((feature) => (
                <li class="flex items-center gap-2.5 text-secondary-text text-sm">
                  <span class="w-1 h-1 rounded-full bg-pink flex-shrink-0" />
                  {feature}
                </li>
              ))
            }
          </ul>

          <div class="flex flex-wrap items-center justify-between gap-8 pt-2 border-t border-pink/20">
            <div>
              <p class="label mb-1">Price</p>
              <p class="text-3xl font-cormorant font-bold text-primary-text">
                {quickService?.price}
              </p>
            </div>
            <Button href="/free-consultation/" variant="primary">
              Book a Free Consultation
            </Button>
          </div>
        </div>
      </div>

      <!-- Image (right, fills remaining space) -->
      <div class="relative flex-1 min-h-[70vw] md:min-h-0">
        <Image
          inferSize
          src="https://images.mellsnap.co.uk/file/mellsnap-website/services/038-Web.jpeg"
          alt="Couple sitting on a bench, looking at each other, love couple photoshoot, photo session by river Thames in Canbury gardens in Kingston, London"
          loading="eager"
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>

    </div>
  </section>

  <!-- Introduction -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <p class="text-secondary-text leading-relaxed mb-6">
          Not every photoshoot needs to take hours. A quick photoshoot can
          capture the most genuine smiles and memories from those candid and
          spontaneous moments. That's why I created the Quick Snap Photo
          Package—a short and easy session designed for anyone who wants
          stunning photos without the hassle of a long shoot.
        </p>
        <p class="text-secondary-text leading-relaxed">
          It's perfect for families, couples, or even professionals looking for
          a fresh, natural portrait. Whether we meet at a beautiful park, your
          cosy home, or even your favourite coffee shop, we'll create something
          truly special together – all in just 20 minutes.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Image -->
  <section class="bg-section-bg">
    <div class="container py-10">
      <div class="max-w-4xl mx-auto">
        <Image
          inferSize
          src="https://images.mellsnap.co.uk/file/mellsnap-website/services/046-Web.jpg"
          alt="Toddler covered in autumn leaves, sitting on the ground, posing for a quick photoshoot for a family in a park in London"
          class="w-full aspect-[3/2] object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          What's Included in My Quick Photoshoot Package?
        </h2>
        <p class="text-secondary-text mb-8">
          Here's what you'll get with this fun and simple package:
        </p>
        <ul class="space-y-4 text-secondary-text">
          <li class="list-disc ml-8">
            <strong class="text-primary-text">A 20-minute photoshoot</strong> – Enough
            time to capture a variety of beautiful, natural shots.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text"
              >20 professionally edited digital images</strong
            > – You'll receive a gallery of polished, high-quality photos that you
            can print, share, or just treasure forever.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Your choice of location</strong> – We
            can shoot outdoors, in your home, or at a coffee shop – whatever feels
            right for you.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Natural and soft edit</strong> – Each
            image is carefully cropped and framed, with gentle, natural edits of the
            colours, lighting and white balance, there are no harsh filters or heavy
            retouching.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Why Choose -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          Why Choose My Quick Snap Photo Package?
        </h2>
        <p class="text-secondary-text mb-10">
          I get it – sometimes, you just want amazing photos without spending a
          lot of time planning or posing. That's exactly what this package is
          for.
        </p>

        <div class="space-y-8">
          <div>
            <h3 class="text-primary-text mb-3">1. Quick and Convenient</h3>
            <p class="text-secondary-text">
              This session is all about keeping things simple. In just 20
              minutes, we'll create a set of gorgeous images that feel relaxed
              and effortless. It's perfect if you're short on time or just
              prefer a more casual experience.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-3">2. Flexible Locations</h3>
            <p class="text-secondary-text">
              Want to head outdoors to a local park? Stay at home for some
              personal, cosy vibes? Or maybe pop into a coffee shop for a
              stylish lifestyle feel? The choice is yours, and I'll make it work
              beautifully.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-3">
              3. Professional, High-Quality Results
            </h3>
            <p class="text-secondary-text">
              Even though it's a short session, I promise the same level of care
              and attention as my longer shoots. Every image is carefully edited
              to bring out the best moments and details.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-3">4. Perfect for Any Occasion</h3>
            <p class="text-secondary-text">
              Whether you're updating your family album, marking a milestone
              with your partner, or just want a new profile picture, this
              package is as versatile as it gets.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who Is This For -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          Who Is This Package For?
        </h2>
        <p class="text-secondary-text mb-8">
          I recommend the quick photoshoot package for:
        </p>
        <ul class="space-y-4 text-secondary-text">
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Families</strong> – Quick, fun sessions
            where the kids can just be themselves.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Couples</strong> – Perfect for capturing
            your connection in a relaxed, natural way.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Professionals</strong> – Great for refreshing
            your headshot or LinkedIn profile.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Anyone</strong> – If you want amazing
            photos but don't need a long photoshoot, this is for you!
          </li>
        </ul>
        <Image
          inferSize
          src="https://images.mellsnap.co.uk/file/mellsnap-website/services/010-Web.jpg"
          alt="Family of three sitting on a tree, mum kissing her son, dad looking at them"
          class="w-full aspect-[3/2] object-cover mt-8"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Locations -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">Where Can We Shoot?</h2>
        <p class="text-secondary-text mb-8">
          Not sure where to hold your photoshoot? Here are some ideas:
        </p>
        <ul class="space-y-4 text-secondary-text mb-8">
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Local parks</strong> – I love working
            in spots like <strong>Richmond Park</strong>, <strong
              >Bushy Park</strong
            >, or <strong>Canbury Gardens</strong>.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Your home</strong> – Nothing beats the
            personal touch of capturing you and your loved ones in your own space.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Coffee shops</strong> – Trendy, relaxed,
            and great for lifestyle portraits.
          </li>
        </ul>
        <p class="text-secondary-text">
          I can also recommend parks around London depending on the vibe you
          want to get from the photoshoot. Wherever we go, I'll guide you to
          make sure we make the most of our time together.
        </p>
      </div>
    </div>
  </section>

  <!-- Next Steps -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">What Happens Next?</h2>
        <p class="text-secondary-text mb-8">Here's how we'll make it happen:</p>
        <ol class="space-y-4 text-secondary-text">
          <li class="list-disc ml-8">
            <strong class="text-primary-text"
              >Pick your date and location</strong
            > – Visit my <a
              href="/free-consultation/"
              class="text-pink underline">free consultation page</a
            >, or <a href="/contact/" class="text-pink underline">contact me</a> to
            discuss availability and location preferences.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Book your session</strong> – I'll get
            you all set up and ready to go.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Enjoy the shoot</strong> – You don't
            need to prepare or stress. Just show up, and I'll take care of the rest.
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">FAQs</h2>
        <p class="text-secondary-text mb-8">
          Here are some common questions about the quick photoshoot package:
        </p>
        <ul class="space-y-4 text-secondary-text">
          <li>
            <h3 class="text-pink font-bold! text-xl!">
              Can I bring my pet along?
            </h3>
            Yes, please! Pets always add extra charm to a session, and I love capturing
            them.
          </li>
          <li>
            <h3 class="text-pink font-bold! text-xl!">
              What if it rains for an outdoor shoot?
            </h3>
            No worries – we can either reschedule or switch to an indoor option, like
            your home or a coffee shop.
          </li>
          <li>
            <h3 class="text-pink font-bold! text-xl!">
              How soon will I get my photos?
            </h3>
            I'll deliver all of your successful digital images in a secure gallery
            within 2–3 days of the shoot.
          </li>
          <li>
            <h3 class="text-pink font-bold! text-xl!">
              What if I want more time or photos?
            </h3>
            If you'd like a longer session or extra images, take a look at my <a
              href="/full-photoshoot/"
              class="text-pink underline">Full Session Package</a
            > – it might be exactly what you need!
          </li>
          <li>
            <h3 class="text-pink font-bold! text-xl!">
              Let's Create Something Beautiful – Fast and Easy
            </h3>
            The quick photoshoot is perfect if you want gorgeous photos with no fuss.
            Whether it's a family session, a couple's portrait, or just some fresh,
            natural shots for yourself, I'll make sure it's a fun and effortless experience.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28 bg-beige">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl text-primary-text mb-6">
          Ready to Book Your Quick Photoshoot?
        </h2>
        <p class="text-secondary-text mb-10">
          Let's create something beautiful together – in just 20 minutes.
        </p>
        <Button href="/free-consultation/" variant="primary">
          Book a Free Consultation
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
