---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { packageJsonLd } from "../utils/structuredData";
import FaqSection from "../components/FaqSection.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { services } from "../data/services";
import { Image } from "astro:assets";
import familyParkImage from "../images/full-session-family-park.jpg";
import sistersBenchImage from "../images/full-session-sisters-bench.jpg";
import mumCradlingNewborn from "../images/newborn/mum-cradling-newborn.jpg";
import bigSisterNewbornSofa from "../images/newborn/big-sister-newborn-sofa.jpg";
import newbornFeetBw from "../images/newborn/newborn-feet-bw.jpg";
import newbornTinyHand from "../images/newborn/newborn-tiny-hand.jpg";
import siblingHandsBw from "../images/newborn/sibling-hands-bw.jpg";
import dadSisterNewborn from "../images/newborn/dad-sister-newborn.jpg";

const galleryPhotos = [
  { src: mumCradlingNewborn, alt: "Mum gently cradling her sleeping newborn at home", position: "object-top" },
  { src: bigSisterNewbornSofa, alt: "Big sister cuddling her newborn baby sibling on the sofa" },
  { src: newbornFeetBw, alt: "Black and white close-up of a newborn baby's tiny feet on a knitted blanket" },
  { src: newbornTinyHand, alt: "Newborn baby in a cream knit outfit holding a parent's finger" },
  { src: siblingHandsBw, alt: "Black and white close-up of big sister holding her newborn sibling's hand" },
  { src: dadSisterNewborn, alt: "Dad and big sister snuggling the newborn baby at home", position: "object-top" },
];

const fullService = services.find((service) => service.id === "full");

const faqs = [
  {
    question: "Can we bring props or outfit changes?",
    answer: "Of course! With an hour to work with, there's plenty of time for outfit changes or props to personalise your session.",
  },
  {
    question: "What if it rains for an outdoor shoot?",
    answer: "No need to worry, we can either reschedule or move the session to an indoor location like your home or a local café.",
  },
  {
    question: "How will I receive my photos?",
    answer: "Your images will be delivered in a secure online gallery, where you can easily download or share them. They will be stored for up to one month, so be sure to download them and keep them in a safe place.",
  },
  {
    question: "What if we need more time?",
    answer: "If you think an hour might not be enough, let's chat! I can recommend additional options to suit your needs.",
  },
];

const jsonLd = fullService
  ? packageJsonLd(fullService, "/full-photoshoot/", "Capture your story with a relaxed 1-hour photoshoot. Includes 80+ edited images, an online gallery, and fast delivery. Perfect for families and couples!", faqs)
  : null;
---

<BaseLayout
  title="Full Photoshoot"
  description="Capture your story with a relaxed 1-hour photoshoot. Includes 80+ edited images, an online gallery, and fast delivery. Perfect for families and couples!"
  ogImage={fullService?.image.src}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <!-- Hero -->
  <section class="relative overflow-hidden bg-linen">
    <div class="flex flex-col md:flex-row md:min-h-screen">
      <div
        class="flex-none md:w-1/2 flex items-center py-16 px-8 md:pl-8 lg:pl-8 xl:pl-8 md:pr-0 relative z-10"
      >
        <div
          class="bg-white shadow-2xl p-8 md:p-10 lg:p-12 w-full md:translate-x-10"
        >
          <p class="font-raleway text-xs uppercase tracking-widest mb-5">
            Photography Package
          </p>

          <h1 class="text-primary-text leading-none mb-6">Full Photoshoot</h1>

          <p class="font-ephesis text-pink text-4xl mb-8 leading-none">
            relaxed and natural, 1 hour just for you.
          </p>

          <p
            class="text-secondary-text font-cormorant text-xl italic mb-10 leading-relaxed"
          >
            A relaxed session for families and couples who want a complete
            gallery of beautiful, natural memories.
          </p>

          <div class="w-10 h-px bg-pink/40 mb-6"></div>

          <ul class="space-y-2.5 mb-8">
            {
              fullService?.features.map((feature) => (
                <li class="flex items-center gap-2.5 text-secondary-text text-sm">
                  <span class="w-1 h-1 rounded-full bg-pink flex-shrink-0" />
                  {feature}
                </li>
              ))
            }
          </ul>

          <div
            class="flex flex-wrap items-center justify-between gap-8 pt-2 border-t border-pink/20"
          >
            <div>
              <p class="label mb-1">Price</p>
              <p class="text-3xl font-cormorant font-bold text-primary-text">
                {fullService?.price}
              </p>
            </div>
            <Button href="/free-consultation/" variant="primary">
              Book a Free Consultation
            </Button>
          </div>
        </div>
      </div>

      <div class="relative flex-1 min-h-[70vw] md:min-h-0">
        <Image
          inferSize
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/family/125-Web.jpg"
          alt="Two mothers with their children, holding their babies and lifting them in the air, posing for a family photoshoot"
          loading="eager"
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Introduction -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <p class="text-secondary-text leading-relaxed mb-6">
          If you're looking for a more relaxed photography experience, my <strong
            class="text-primary-text">Full Story Photo Package</strong
          > is just for you. With plenty of time to capture those genuine smiles and
          moments, this package is perfect for creating a full gallery of memories.
        </p>
        <p class="text-secondary-text leading-relaxed">
          Whether you're celebrating a family milestone, marking a special
          occasion, or simply updating your photo collection, the Full Story
          package gives us the time and space to explore your favourite
          location, try different setups, and truly tell your story through
          beautiful, natural images.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Image -->
  <section class="bg-linen">
    <div class="container py-10">
      <div class="max-w-4xl mx-auto">
        <Image
          src={familyParkImage}
          alt="Smiling family of three holding hands with their son as he balances on a fallen log in a sunlit park"
          class="w-full aspect-3/2 object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          What's Included in My Full Story Photo Package?
        </h2>
        <p class="text-secondary-text mb-8">
          Here's what you'll get with this flexible and relaxed session:
        </p>
        <ul class="space-y-4 text-secondary-text">
          <li class="list-disc ml-8">
            <strong class="text-primary-text">A 1-hour photoshoot</strong> – Enough
            time to settle in, try different ideas, and create a variety of gorgeous
            shots.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text"
              >80+ professionally edited digital images</strong
            > – A full gallery of polished, high-quality photos to treasure forever.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">7–10 day delivery</strong> – You won't
            have to wait long to enjoy your photos.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Secure online gallery</strong> – Your
            photos are delivered in a private gallery for easy viewing, sharing, and
            downloading, and they are active for up to one month.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Natural and soft edit</strong> – Each
            image is carefully cropped and framed, with gentle, natural edits of the
            colours, lighting and white balance, there are no harsh filters or heavy
            retouching.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Why Choose -->
  <section class="py-20 md:py-28 bg-linen">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          Why Choose the Full Story Photo Package?
        </h2>
        <p class="text-secondary-text mb-10">
          Sometimes, you need a little more time to relax, enjoy the process,
          and let the magic unfold naturally. This package gives us the
          flexibility to capture a wide range of photos – from playful, candid
          moments to beautifully composed portraits.
        </p>

        <div class="space-y-8">
          <div>
            <h3 class="text-primary-text mb-3">1. Relaxed and Unhurried</h3>
            <p class="text-secondary-text">
              With a full hour to work together, there's no need to rush. We can
              take our time exploring your chosen location, letting everyone
              settle in and feel comfortable in front of the camera.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-3">2. Plenty of Variety</h3>
            <p class="text-secondary-text">
              An hour-long session gives us the chance to capture a mix of group
              shots, individual portraits, and those in-between candid moments
              that make your gallery truly special and unique.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-3">
              3. Perfect for Families and Couples
            </h3>
            <p class="text-secondary-text">
              Whether it's playing with the kids, sharing a laugh with your
              partner, or simply enjoying a moment together, the Full Story
              package is perfect for capturing genuine connections.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-3">4. High-Quality Results</h3>
            <p class="text-secondary-text">
              With over 80 beautifully edited high-quality images delivered,
              you'll have a full story of your session to look back on – perfect
              for creating photo albums, prints, or wall art.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who Is This For -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          Who Is This Package For?
        </h2>
        <p class="text-secondary-text mb-8">
          I designed the Full Story package for anyone who wants to take their
          time and enjoy a complete photography experience:
        </p>
        <ul class="space-y-4 text-secondary-text">
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Families</strong> – From toddlers playing
            in the park to cosy moments at home, we'll capture the love and joy of
            your family.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Couples</strong> – A romantic hour together,
            filled with laughter, connection, and beautiful portraits.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Celebrations</strong> – Perfect for
            anniversaries, engagements, or maternity sessions.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Anyone</strong> – If you want a full
            gallery of stunning images to treasure forever, this is the package for
            you.
          </li>
        </ul>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mt-8">
          {
            galleryPhotos.map((photo) => (
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[400, 800]}
                sizes="(min-width: 768px) 250px, 50vw"
                class:list={["w-full aspect-4/5 object-cover", photo.position]}
                loading="lazy"
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Where Can We Shoot? -->
  <section class="py-20 md:py-28 bg-linen">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">Where Can We Shoot?</h2>
        <p class="text-secondary-text mb-8">
          The beauty of this package is that it works wherever you feel most
          comfortable. Here are some ideas to inspire you:
        </p>
        <ul class="space-y-4 text-secondary-text">
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Outdoor parks</strong> – Richmond Park,
            Bushy Park, or Canbury Gardens are fantastic spots for natural, scenic
            photos.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">At home</strong> – Your home can provide
            a cosy, personal backdrop for relaxed and meaningful images.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text"
              >Cityscapes or local landmarks</strong
            > – We can create beautiful photos in a location that holds special meaning
            to you.
          </li>
        </ul>
        <p class="mt-8 mb-8">
          Not sure where to shoot? – Let's chat, and I'll help you choose the
          perfect location.
        </p>
        <Image
          src={sistersBenchImage}
          alt="Two sisters resting their heads together and smiling on a wooden garden bench"
          class="w-full aspect-[3/2] object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- What Happens Next? -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">What Happens Next?</h2>
        <p class="text-secondary-text mb-8">
          It's easy to book your Full Story photo session:
        </p>

        <ul class="space-y-4 text-secondary-text">
          <li class="list-disc ml-8">
            Pick your date and location – Visit my <a
              href="/free-consultation/"
              class="hover:text-pink transition-colors underline underline-offset-2"
              >free consultation page</a
            >, or
            <a
              href="/contact/"
              class="hover:text-pink transition-colors underline underline-offset-2"
              >contact me</a
            > to discuss availability and location preferences.
          </li>
          <li class="list-disc ml-8">
            Prepare for the shoot – I'll provide you with tips and ideas to help
            you get ready, but remember, the most important thing is to be
            yourself and have fun!
          </li>
          <li class="list-disc ml-8">
            Enjoy the shoot – You don't need to prepare or stress. Just show up,
            and I'll take care of the rest.
          </li>
        </ul>
        <p class="text-secondary-text mt-8">
          After the shoot, I'll carefully edit your photos and deliver them in a
          secure online gallery within 7–10 days. From there, you can download,
          share, and enjoy your beautiful images for years to come.
        </p>
        <p class="text-secondary-text mt-8">
          The gallery will be active for up to one month, so be sure to download
          your photos and keep them in a safe place.
        </p>
      </div>
    </div>
  </section>

  <FaqSection title="Full Session FAQs" faqs={faqs} />

  <CtaBanner
    title="Ready to Book Your Full Story Session?"
    text={"Let's take our time and create something truly special together."}
    buttonText="Book a Free Consultation"
  />
</BaseLayout>
