---
import BaseLayout from "../layouts/BaseLayout.astro";

import { Image } from "astro:assets";
import consultationImage from "../images/consultation.webp";
---

<BaseLayout
  title="Free Consultation"
  description="Book a free consultation to discuss your photography session with MellSnap."
>
  <!-- Hero -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center">
        <p class="label mb-4">Let's Chat</p>
        <h1
          class="font-cormorant text-4xl md:text-5xl lg:text-6xl text-primary-text"
        >
          Free Consultation
        </h1>
        <p
          class="font-cormorant text-xl text-secondary-text mt-6 max-w-2xl mx-auto"
        >
          Not sure which package is right for you? Let's have a chat to discuss
          your needs and create the perfect session.
        </p>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="pb-20 bg-white">
    <div class="container">
      <div class="mx-auto">
        <!-- Info -->
        <div class="py-20 grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
          <div>
            <h2 class="font-cormorant text-3xl text-primary-text mb-6">
              What We'll Discuss
            </h2>

            <ul class="">
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 448 512"
                >
                  <path
                    d="M384 32C419.3 32 448 60.65 448 96V416C448 451.3 419.3 480 384 480H64C28.65 480 0 451.3 0 416V96C0 60.65 28.65 32 64 32H384zM339.8 211.8C350.7 200.9 350.7 183.1 339.8 172.2C328.9 161.3 311.1 161.3 300.2 172.2L192 280.4L147.8 236.2C136.9 225.3 119.1 225.3 108.2 236.2C97.27 247.1 97.27 264.9 108.2 275.8L172.2 339.8C183.1 350.7 200.9 350.7 211.8 339.8L339.8 211.8z"
                  ></path>
                </svg>Your vision for the session
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 448 512"
                >
                  <path
                    d="M384 32C419.3 32 448 60.65 448 96V416C448 451.3 419.3 480 384 480H64C28.65 480 0 451.3 0 416V96C0 60.65 28.65 32 64 32H384zM339.8 211.8C350.7 200.9 350.7 183.1 339.8 172.2C328.9 161.3 311.1 161.3 300.2 172.2L192 280.4L147.8 236.2C136.9 225.3 119.1 225.3 108.2 236.2C97.27 247.1 97.27 264.9 108.2 275.8L172.2 339.8C183.1 350.7 200.9 350.7 211.8 339.8L339.8 211.8z"
                  ></path>
                </svg>Best package for your needs
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 448 512"
                >
                  <path
                    d="M384 32C419.3 32 448 60.65 448 96V416C448 451.3 419.3 480 384 480H64C28.65 480 0 451.3 0 416V96C0 60.65 28.65 32 64 32H384zM339.8 211.8C350.7 200.9 350.7 183.1 339.8 172.2C328.9 161.3 311.1 161.3 300.2 172.2L192 280.4L147.8 236.2C136.9 225.3 119.1 225.3 108.2 236.2C97.27 247.1 97.27 264.9 108.2 275.8L172.2 339.8C183.1 350.7 200.9 350.7 211.8 339.8L339.8 211.8z"
                  ></path>
                </svg>Location recommendations
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 448 512"
                >
                  <path
                    d="M384 32C419.3 32 448 60.65 448 96V416C448 451.3 419.3 480 384 480H64C28.65 480 0 451.3 0 416V96C0 60.65 28.65 32 64 32H384zM339.8 211.8C350.7 200.9 350.7 183.1 339.8 172.2C328.9 161.3 311.1 161.3 300.2 172.2L192 280.4L147.8 236.2C136.9 225.3 119.1 225.3 108.2 236.2C97.27 247.1 97.27 264.9 108.2 275.8L172.2 339.8C183.1 350.7 200.9 350.7 211.8 339.8L339.8 211.8z"
                  ></path>
                </svg>Styling and outfit guidance
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green mt-1 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 448 512"
                >
                  <path
                    d="M384 32C419.3 32 448 60.65 448 96V416C448 451.3 419.3 480 384 480H64C28.65 480 0 451.3 0 416V96C0 60.65 28.65 32 64 32H384zM339.8 211.8C350.7 200.9 350.7 183.1 339.8 172.2C328.9 161.3 311.1 161.3 300.2 172.2L192 280.4L147.8 236.2C136.9 225.3 119.1 225.3 108.2 236.2C97.27 247.1 97.27 264.9 108.2 275.8L172.2 339.8C183.1 350.7 200.9 350.7 211.8 339.8L339.8 211.8z"
                  ></path>
                </svg>Any questions you have
              </li>
            </ul>
            <p class="font-cormorant text-lg text-secondary-text mt-8">
              Consultations can be done via phone, video call, or in person at a
              convenient location. There's no obligation to book after our chat.
            </p>
          </div>
          <Image
            src={consultationImage}
            alt="Free consultation MellSnap Photography"
            class="shadow-lg w-full"
          />
        </div>
        <!-- Calendly Widget -->
        <div>
          <!-- Calendly inline widget begin -->
          <div
            class="calendly-inline-widget"
            data-url="https://calendly.com/mellsnap/free-consultation"
            style="min-width:320px;height:700px;"
          >
          </div>
          <script
            is:inline
            type="text/javascript"
            src="https://assets.calendly.com/assets/external/widget.js"
            async></script>
          <!-- Calendly inline widget end -->
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
