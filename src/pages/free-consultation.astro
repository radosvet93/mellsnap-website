---
import BaseLayout from "../layouts/BaseLayout.astro";

import { Image } from "astro:assets";
import consultationImage from "../images/couple-bridge-azaleas.jpg";

const topics = [
  "Your vision for the session",
  "The best package for your needs",
  "Location recommendations",
  "Styling and outfit guidance",
  "Any questions you have",
];

const steps = [
  "Pick a day and time in the calendar above",
  "Receive a confirmation email and calendar invite",
  "I'll be in touch with you at your chosen time",
];
---

<BaseLayout
  title="Free Consultation"
  description="Book a free 10-minute consultation with Gaby, photographer in Kingston upon Thames, to plan your family, maternity, couple or event photoshoot. No booking fee."
>
  <!-- Hero -->
  <section class="bg-linen py-12 md:py-16">
    <div class="container">
      <div
        class="grid md:grid-cols-12 gap-10 md:gap-8 lg:gap-16 items-center max-w-5xl mx-auto"
      >
      <div class="md:col-span-7 text-center md:text-left">
        <p class="label mb-4">Book me</p>
        <h1
          class="text-primary-text text-[2.25rem]! md:text-[2.75rem]! lg:text-[3.25rem]! leading-[1.08]! tracking-tight mb-6 max-w-[13em] mx-auto md:mx-0 [font-variant-numeric:lining-nums]"
        >
          Book your free <span class="whitespace-nowrap">10-minute</span> consultation
        </h1>
        <p
          class="text-secondary-text text-lg leading-relaxed max-w-[46ch] mx-auto md:mx-0 mb-6"
        >
          Not sure which package is right for you? Pick a time below for a
          quick, relaxed chat and I'll help you plan the perfect session.
        </p>
        <p class="font-raleway text-sm text-pink">Free, with no booking fee</p>
      </div>

      <!-- Hidden on phones so the calendar stays close to the top -->
      <div class="hidden md:flex md:col-span-5 justify-end">
        <Image
          src={consultationImage}
          widths={[400, 800]}
          sizes="(min-width: 768px) 320px, 0px"
          alt="Couple embracing on a wooden bridge between bright pink azaleas in a garden"
          class="w-full max-w-xs aspect-4/5 object-cover border-8 border-white shadow-xl"
          loading="eager"
        />
      </div>
      </div>
    </div>
  </section>

  <!-- Calendly -->
  <section id="book" class="bg-white pt-4 pb-10 md:pt-6 md:pb-12">
    <div class="container">
      <div>
        <div
          class="calendly-inline-widget"
          data-url="https://calendly.com/mellsnap/free-consultation"
          style="min-width:320px;height:700px;"
        >
        </div>
        <script
          is:inline
          type="text/javascript"
          src="https://assets.calendly.com/assets/external/widget.js"
          async></script>
      </div>
    </div>
  </section>

  <!-- Details -->
  <section class="py-20 md:py-28 bg-linen">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-16 md:gap-12 lg:gap-24 max-w-5xl mx-auto">
        <div>
          <h2 class="text-3xl! text-primary-text mb-6">What we'll chat about</h2>
          <ul class="space-y-3 text-secondary-text">
            {
              topics.map((topic) => (
                <li class="flex items-start gap-3">
                  <svg
                    class="w-5 h-5 mt-1 text-pink shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  {topic}
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="text-3xl! text-primary-text mb-6">How booking a free consultation works</h2>
          <ul class="space-y-3 text-secondary-text">
            {steps.map((step) => <li>{step}</li>)}
          </ul>
          <p
            class="mt-8 pl-5 border-l-2 border-pink text-primary-text leading-relaxed"
          >
            There's no booking fee when you reserve your photo session, so
            there's nothing to pay upfront.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
