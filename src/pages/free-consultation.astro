---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout
  title="Free Consultation"
  description="Book a free consultation to discuss your photography session with MellSnap."
>
  <!-- Hero -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center">
        <p class="label mb-4">Let's Chat</p>
        <h1
          class="font-cormorant text-4xl md:text-5xl lg:text-6xl text-primary-text"
        >
          Free Consultation
        </h1>
        <p
          class="font-cormorant text-xl text-secondary-text mt-6 max-w-2xl mx-auto"
        >
          Not sure which package is right for you? Let's have a chat to discuss
          your needs and create the perfect session.
        </p>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start">
          <!-- Info -->
          <div>
            <h2 class="font-cormorant text-3xl text-primary-text mb-6">
              What We'll Discuss
            </h2>
            <ul class="space-y-4 font-cormorant text-lg text-secondary-text">
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-pink mt-1 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Your vision for the session
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-pink mt-1 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Best package for your needs
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-pink mt-1 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Location recommendations
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-pink mt-1 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Styling and outfit guidance
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-pink mt-1 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Any questions you have
              </li>
            </ul>

            <p class="font-cormorant text-lg text-secondary-text mt-8">
              Consultations can be done via phone, video call, or in person at a
              convenient location. There's no obligation to book after our chat.
            </p>
          </div>

          <!-- Form -->
          <div>
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
