---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { Image } from "astro:assets";
import { fetchGoogleReviews } from "../data/googleReviews";

import kiteImage from "../images/kite.JPEG";
import gabyImage from "../images/gaby-meli.png";
import familyImage from "../images/family/parents-swinging-toddler.jpg";
import maternityImage from "../images/maternity/couple-dog-willow.jpg";
import coupleImage from "../images/couples/couple-pond-embrace.jpg";
import childrenImage from "../images/children/siblings-bench-hug.jpg";
import eventImage from "../images/events/birthday-cake.jpg";
import familyServiceImage from "../images/family/three-generations-bench.jpg";
import maternityServiceImage from "../images/maternity/mum-riverbank.jpg";
import childrenServiceImage from "../images/children/curly-boy-tulips.jpg";
import coupleServiceImage from "../images/couples/couple-meadow-dip.jpg";
import eventServiceImage from "../images/events/dancing.jpg";
import richmondImage from "../images/blog/couple-richmond-park-grass.jpg";

const reviewStats = fetchGoogleReviews();

// One photo from each type of session
const strip = [
  { src: familyImage, alt: "Parents swinging their toddler between them along a leafy garden path" },
  { src: maternityImage, alt: "Expecting couple kissing by the river with their golden retriever" },
  { src: coupleImage, alt: "Couple sharing a tender moment beside a pond surrounded by pink azaleas" },
  { src: childrenImage, alt: "Brother and sister hugging and laughing on a garden bench" },
  { src: eventImage, alt: "Birthday girl smiling at her rainbow birthday cake" },
];

const reasons = [
  {
    title: "Natural style",
    text: "My sessions focus on candid moments, natural smiles and the joy of family life, with no stiff poses or forced grins.",
    icon: "M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z",
  },
  {
    title: "Outdoor expertise",
    text: "I use the beauty of nature as your backdrop, from golden sunsets to vibrant greenery and riverside paths.",
    icon: "M5 21c0-9 5-15 15-16-1 10-7 15-15 16zm0 0 7-7",
  },
  {
    title: "Relaxed sessions",
    text: "Every session is fun, relaxed and enjoyable for everyone, especially the kids, who are free to play and be themselves.",
    icon: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM8.5 14.5a4.5 4.5 0 0 0 7 0M9 9.5h.01M15 9.5h.01",
  },
  {
    title: "Tailored to you",
    text: "Whether it's a quiet stroll in Richmond Park or a lively birthday party, I'll plan a session that reflects your personality.",
    icon: "M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z",
  },
];

const services = [
  {
    title: "Family Photography",
    text: "The love and connection of your family in a natural, outdoor setting, from playful sessions in Bushy Park to strolls along the River Thames.",
    image: familyServiceImage,
    alt: "Three generations of a family smiling together on a park bench",
    href: "/portfolio/family/",
  },
  {
    title: "Maternity Photography",
    text: "A gentle, relaxed session to celebrate your bump among flowers, trees and soft riverside light.",
    image: maternityServiceImage,
    alt: "Pregnant mum in a blue floral dress sitting by the river holding her bump",
    href: "/portfolio/maternity/",
  },
  {
    title: "Children's Photography",
    text: "Children grow up so quickly. I capture their giggles, curiosity and cheeky smiles in a relaxed, playful way.",
    image: childrenServiceImage,
    alt: "Surprised curly-haired little boy in front of red tulips",
    href: "/portfolio/children/",
  },
  {
    title: "Couples Photography",
    text: "Celebrate your love with a romantic photoshoot in one of Kingston's scenic outdoor locations, by the water or at golden hour.",
    image: coupleServiceImage,
    alt: "Groom dipping his bride for a kiss in a field of tall golden grass",
    href: "/portfolio/love/",
  },
  {
    title: "Event Photography",
    text: "From birthdays to milestones, I document your special day with candid, vibrant photos full of laughter and togetherness.",
    image: eventServiceImage,
    alt: "Children dancing with their arms in the air at a birthday party",
    href: "/portfolio/events/",
  },
];

const steps = [
  {
    title: "Free pre-shoot consultation",
    text: "We start with a quick chat about your vision, location preferences, any moments you'd like captured and any questions you have.",
  },
  {
    title: "Relaxed photoshoot",
    text: "On the day, my approach is flexible and fun. I guide you gently so everyone feels comfortable, and the kids are free to play rather than pose.",
  },
  {
    title: "Beautiful results",
    text: "I carefully edit every photo to bring out its natural beauty, then deliver them in a secure online gallery, ready to download and share.",
  },
];

const locations = [
  { name: "Richmond Park", text: "open spaces, golden sunsets and woodland backdrops" },
  { name: "Bushy Park", text: "wide open spaces, playful deer and seasonal colours" },
  { name: "Twickenham Riverside", text: "romantic, timeless photos by the water" },
  { name: "Canbury Gardens, Kingston", text: "lush greenery and riverside charm" },
];
---

<BaseLayout
  title="About Me"
  ogImage={gabyImage}
  description="Meet Gaby, family, maternity, couples and event photographer in Kingston upon Thames. Natural, candid outdoor photography across South West London."
>
  <!-- Hero -->
  <section class="bg-linen py-16 md:py-24">
    <div class="container">
      <div
        class="grid md:grid-cols-12 gap-12 md:gap-8 lg:gap-16 items-center max-w-6xl mx-auto"
      >
        <div class="md:col-span-5 flex justify-center md:justify-start">
          <Image
            src={gabyImage}
            widths={[480, 800]}
            sizes="(min-width: 768px) 40vw, 90vw"
            alt="Gaby, family photographer in Kingston upon Thames, laughing and hugging her daughter on an autumn walk"
            class="w-full max-w-sm lg:max-w-md aspect-4/5 object-cover border-8 border-white shadow-xl object-[center_35%]"
            loading="eager"
          />
        </div>

        <div class="md:col-span-7 text-center md:text-left">
          <p class="font-ephesis text-4xl md:text-5xl text-pink mb-3">
            Hello, I'm Gaby
          </p>
          <h1
            class="text-primary-text text-[2.25rem]! md:text-[2.75rem]! lg:text-[3.25rem]! leading-[1.08]! tracking-tight mb-8 max-w-[18ch] mx-auto md:mx-0"
          >
            Family, lifestyle and event photographer in Kingston upon Thames
          </h1>
          <div
            class="space-y-4 text-secondary-text leading-relaxed max-w-[58ch] mx-auto md:mx-0 mb-10"
          >
            <p>
              I'm a Kingston family photographer specialising in outdoor
              photography. I capture natural, candid moments for families,
              children, mums-to-be and couples across South West London,
              including Richmond, Surbiton, Ham and nearby areas.
            </p>
            <p>
              I've always loved taking photos, and I've always loved being in
              front of the camera too. When my first child was born, that
              lifelong passion became my professional photography business.
            </p>
            <p>
              As a mum, I understand how important it is to keep those fleeting
              moments with your loved ones, from the playful laughter of
              children to the quiet closeness of a couple's embrace.
            </p>
          </div>
          <Button href="/free-consultation/">Book a Free Consultation</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo strip -->
  <section aria-label="A few of my favourite photos">
    <div class="grid grid-cols-2 md:grid-cols-5">
      {
        strip.map((photo, i) => (
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[400, 700]}
            sizes="(min-width: 768px) 20vw, 50vw"
            class:list={[
              "w-full aspect-4/5 object-cover",
              { "hidden md:block": i === strip.length - 1 },
            ]}
            loading="lazy"
          />
        ))
      }
    </div>
  </section>

  <!-- Why choose me -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="label mb-4">Why choose me</p>
        <h2 class="text-primary-text mb-6">
          Why Choose Me as Your Family Photographer?
        </h2>
        <p class="text-secondary-text leading-relaxed">
          I know choosing a photographer can feel overwhelming. You want
          someone who understands your family, makes everyone feel at ease and
          captures your story. Here's what sets me apart.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {
          reasons.map((reason) => (
            <div class="bg-linen p-8 text-center">
              <span class="inline-grid place-items-center w-14 h-14 rounded-full bg-white text-pink mb-6">
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d={reason.icon} />
                </svg>
              </span>
              <h3 class="text-2xl! text-primary-text mb-3">{reason.title}</h3>
              <p class="text-secondary-text leading-relaxed">{reason.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How I can help -->
  <section class="py-20 md:py-28 bg-linen">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="label mb-4">Services</p>
        <h2 class="text-primary-text mb-6">How I Can Help</h2>
        <p class="text-secondary-text leading-relaxed">
          I offer a range of photography sessions across Kingston upon Thames,
          Richmond and beyond.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-6 max-w-6xl mx-auto">
        {
          services.map((service) => (
            <a
              href={service.href}
              class="group flex flex-col bg-white shadow-sm w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pink"
            >
              <div class="aspect-4/3 overflow-hidden">
                <Image
                  src={service.image}
                  alt={service.alt}
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-col flex-1 p-7">
                <h3 class="text-2xl! text-primary-text mb-3">{service.title}</h3>
                <p class="text-secondary-text leading-relaxed mb-5">
                  {service.text}
                </p>
                <span class="mt-auto font-raleway text-sm text-pink underline underline-offset-4">
                  View gallery
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What to expect -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="label mb-4">Your session</p>
        <h2 class="text-primary-text mb-6">What to Expect from Your Session</h2>
        <p class="text-secondary-text leading-relaxed">
          Life with kids can be a little hectic and unpredictable, so I keep
          your photoshoot as simple and stress-free as possible. I love working
          with children, and it's what I specialise in.
        </p>
      </div>

      <ul class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {
          steps.map((step) => (
            <li class="bg-linen p-8 text-center">
              <h3 class="text-2xl! text-primary-text mb-3">{step.title}</h3>
              <p class="text-secondary-text leading-relaxed">{step.text}</p>
            </li>
          ))
        }
      </ul>

      <p class="text-center text-secondary-text italic mt-14">
        I take on a limited number of clients each month, so every family gets
        the attention and care they deserve.
      </p>
    </div>
  </section>

  <!-- Locations -->
  <section class="py-20 md:py-28 bg-linen">
    <div class="container">
      <div
        class="grid md:grid-cols-12 gap-12 md:gap-8 lg:gap-16 items-center max-w-6xl mx-auto"
      >
        <div class="md:col-span-5 flex justify-center md:justify-start">
          <Image
            src={richmondImage}
            widths={[480, 800]}
            sizes="(min-width: 768px) 40vw, 90vw"
            alt="Groom dipping his bride for a kiss in the tall golden grass of Richmond Park"
            class="w-full max-w-sm lg:max-w-md aspect-4/5 object-cover border-8 border-white shadow-xl"
            loading="lazy"
          />
        </div>

        <div class="md:col-span-7">
          <p class="label mb-4 text-center md:text-left">Where I work</p>
          <h2 class="text-primary-text mb-6 text-center md:text-left">
            Stunning Outdoor Locations in South West London
          </h2>
          <p class="text-secondary-text leading-relaxed mb-8">
            I feel lucky to work in some of the most beautiful places in South
            West London. Natural light, fresh air and lovely surroundings make
            the perfect backdrop, and outdoor sessions let kids move freely,
            explore and have fun. Here are a few of my favourites:
          </p>

          <ul class="space-y-4 mb-8">
            {
              locations.map((place) => (
                <li class="flex items-start gap-3">
                  <svg
                    class="w-5 h-5 mt-1 text-pink shrink-0"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                  <span class="text-secondary-text">
                    <strong class="text-primary-text font-medium">{place.name}</strong>,
                    {place.text}
                  </span>
                </li>
              ))
            }
          </ul>

          <p class="text-secondary-text leading-relaxed">
            If you have a special location in mind, I'm always happy to explore
            somewhere new. I often photograph families around Central London
            too. There may be extra travel costs outside London, but I'm
            flexible and we can talk it through on your free consultation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <figure class="max-w-3xl mx-auto text-center">
        <span
          class="block font-cormorant text-8xl leading-none text-pink/40 h-12"
          aria-hidden="true">&ldquo;</span
        >
        <div class="flex justify-center gap-1 text-pink mb-6" aria-hidden="true">
          {
            Array.from({ length: 5 }).map(() => (
              <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
              </svg>
            ))
          }
        </div>
        <blockquote
          class="font-cormorant italic text-2xl md:text-3xl text-primary-text leading-snug mb-8"
        >
          We cannot recommend Gabi enough! She was the photographer for our
          wedding and captured every moment, from entering the registry office
          to the end of our reception. She has a real eye for the details.
        </blockquote>
        <figcaption class="font-raleway text-sm text-secondary-text">
          P. Pencheva
          <span class="block mt-3">
            <a
              href="https://share.google/KYxFW8GJmiGjTPqWG"
              target="_blank"
              rel="noopener noreferrer"
              class="text-pink underline underline-offset-4 hover:text-primary-text transition-colors"
              >{reviewStats.averageRating.toFixed(1)} from {reviewStats.totalReviews}
              Google reviews</a
            >
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <CtaBanner
    title="Ready to Book?"
    text="If you're looking for a family photographer in Kingston upon Thames or the surrounding areas, I'd love to hear from you. Get in touch to check availability and book your session."
    image={kiteImage}
  />
</BaseLayout>
