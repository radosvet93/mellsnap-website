---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="About" description="Meet Gaby, the photographer behind MellSnap Photography. Family and portrait photography in Kingston upon Thames.">
  <!-- Hero -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">About</p>
        <h1 class="font-cormorant text-4xl md:text-5xl lg:text-6xl text-primary-text">
          Meet Gaby
        </h1>
      </div>
    </div>
  </section>

  <!-- About Content -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center max-w-6xl mx-auto">
        <!-- Image -->
        <div class="img-hover">
          <img
            src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=600&h=800&fit=crop"
            alt="Gaby - MellSnap Photographer"
            class="w-full aspect-[3/4] object-cover"
          />
        </div>

        <!-- Content -->
        <div>
          <h2 class="font-ephesis text-4xl md:text-5xl text-gold mb-8">
            Hello, I'm Gabriela
          </h2>
          <div class="space-y-6 font-cormorant text-lg md:text-xl text-secondary-text leading-relaxed">
            <p>
              Welcome to MellSnap Photography! I'm Gaby, a family and portrait photographer
              based in Kingston upon Thames, serving South West and Central London.
            </p>
            <p>
              My passion is capturing the genuine connections and authentic moments that make
              your family unique. I believe photography should be an enjoyable experience,
              not a stressful one. That's why I focus on creating a relaxed, fun atmosphere
              where your personality can truly shine through.
            </p>
            <p>
              Whether it's a growing bump, a newborn's tiny fingers, a child's infectious
              laughter, or a family gathering together, I'm here to preserve these precious
              moments for you to treasure forever.
            </p>
            <p>
              When I'm not behind the camera, you'll find me exploring London with my own
              family, discovering new cafes, or getting lost in a good book.
            </p>
          </div>
          <div class="mt-10">
            <Button href="/contact/" variant="primary">
              Let's Work Together
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <p class="label mb-4">My Approach</p>
        <h2 class="font-cormorant text-4xl md:text-5xl text-primary-text mb-12">
          Photography Philosophy
        </h2>

        <div class="grid md:grid-cols-3 gap-10">
          <div>
            <div class="w-16 h-16 mx-auto mb-6 flex items-center justify-center">
              <svg class="w-10 h-10 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h3 class="font-cormorant text-2xl text-primary-text mb-4">Authentic</h3>
            <p class="font-cormorant text-lg text-secondary-text">
              I capture real moments and genuine emotions, not forced poses. Your photos should feel like you.
            </p>
          </div>

          <div>
            <div class="w-16 h-16 mx-auto mb-6 flex items-center justify-center">
              <svg class="w-10 h-10 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-cormorant text-2xl text-primary-text mb-4">Relaxed</h3>
            <p class="font-cormorant text-lg text-secondary-text">
              Sessions are meant to be fun! I create a comfortable atmosphere so everyone can relax and be themselves.
            </p>
          </div>

          <div>
            <div class="w-16 h-16 mx-auto mb-6 flex items-center justify-center">
              <svg class="w-10 h-10 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            </div>
            <h3 class="font-cormorant text-2xl text-primary-text mb-4">Timeless</h3>
            <p class="font-cormorant text-lg text-secondary-text">
              My editing style is clean and natural, creating images that will look beautiful for generations.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <p class="label mb-4">Location</p>
        <h2 class="font-cormorant text-4xl md:text-5xl text-primary-text mb-8">
          Based in Kingston upon Thames
        </h2>
        <p class="font-cormorant text-xl text-secondary-text leading-relaxed mb-6">
          I'm available for sessions throughout South West London, Central London, and surrounding areas.
          Whether you prefer an outdoor location, your home, or a studio setting, I'm happy to accommodate
          your needs.
        </p>
        <p class="font-cormorant text-xl text-secondary-text leading-relaxed">
          Travel within 10 miles of Kingston upon Thames is included. Additional travel can be arranged
          for a small fee.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
