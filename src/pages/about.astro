---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import aboutImage from "../images/kite.JPEG";
import GabyAndMeliImage from "../images/gaby-meli.png";
import Button from "../components/Button.astro";
---

<BaseLayout
  title="About Me"
  description="Natural outdoor family photography in Kingston upon Thames. Capture candid moments with me Gaby, your local Kingston family photographer. Book now!"
>
  <!-- Header -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center mb-16">
        <p class="label mb-4">About Me</p>
        <h1 class="text-primary-text">Meet Your Photographer</h1>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <Image
            src={GabyAndMeliImage}
            alt="Mother and daughter smiling and hugging each other"
            class="w-2/3 md:min-w-xs mx-auto h-auto pt-6 px-6 pb-16 shadow-lg overflow-hidden"
            loading="lazy"
          />
        </div>
        <div class="md:text-left text-center">
          <div class="mb-8">
            <p class="label mb-4">About me</p>
            <h2 class="text-4xl md:text-5xl text-primary-text mb-8">
              Hello, I'm Gaby
            </h2>
          </div>
          <div class="space-y-4 text-secondary-text leading-relaxed mb-10">
            <p>
              A professional <strong>Kingston family photographer</strong> specialising
              in <strong>outdoor family photography</strong>. Based in the heart of
              <strong>Kingston upon Thames</strong>, I capture natural, candid moments
              for families, children, and couples across <strong>South West London</strong>,
              including <strong>Richmond, Surbiton, Ham</strong>, and nearby areas.
            </p>
            <p>
              As a mum, I understand how important it is to preserve those
              fleeting moments with your loved ones. From the playful laughter of
              children to the quiet intimacy of a couple's embrace, my passion
              lies in capturing authentic connections in beautiful outdoor
              settings.
            </p>
          </div>
          <Button href="/free-consultation/">
            Book a Free Consultation
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Me -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          Why Choose Me as Your Family Photographer?
        </h2>
        <p class="text-secondary-text leading-relaxed mb-6">
          I know choosing a photographer can feel overwhelming. You want someone
          who understands your family, makes everyone feel at ease, and captures
          your unique story. Here's what sets me apart:
        </p>
        <ul class="space-y-4 text-secondary-text leading-relaxed mb-12 ml-6 list-disc">
          <li>
            <strong>Natural Style</strong>: My sessions focus on candid moments,
            natural smiles, and the joy of family life—no stiff poses or forced
            grins.
          </li>
          <li>
            <strong>Outdoor Expertise</strong>: As a photographer who
            specialises in outdoor settings, I use the beauty of nature to
            create stunning backdrops for your photos, from golden sunsets to
            vibrant greenery.
          </li>
          <li>
            <strong>Relaxed Sessions</strong>: I ensure your session is fun,
            relaxed, and enjoyable for everyone—especially the kids!
          </li>
          <li>
            <strong>Tailored Experience</strong>: Whether it's a quiet family
            stroll in <strong>Richmond Park</strong> or a lively birthday celebration,
            I'll work with you to create a session that reflects your family's personality.
          </li>
        </ul>
        <p class="text-secondary-text leading-relaxed">
          If you're looking for a South-West family photographer who values
          authentic, heartfelt moments, I'd love to work with you.
        </p>
      </div>
    </div>
  </section>

  <!-- How I Can Help -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">How I Can Help</h2>
        <p class="text-secondary-text leading-relaxed mb-8">
          I offer a range of photography services tailored to families in <strong
            >Kingston upon Thames</strong
          >, <strong>Richmond</strong>, and beyond:
        </p>

        <div class="space-y-8">
          <div>
            <h3 class="text-primary-text mb-3">
              <strong>Family Photography</strong>
            </h3>
            <p class="text-secondary-text leading-relaxed">
              Capture the love and connection of your family in a natural,
              outdoor setting. Whether it's a playful session in Bushy Park or
              along the River Thames, I'll help you create timeless memories
              filled with joy and authenticity.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-3">
              <strong>Children's Photography</strong>
            </h3>
            <p class="text-secondary-text leading-relaxed">
              Children grow up so quickly—why not preserve their unique
              personalities and precious moments with a relaxed, fun photoshoot?
              I specialise in candid shots that highlight their giggles,
              curiosity, and cheeky smiles.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-3">
              <strong>Couples Photography</strong>
            </h3>
            <p class="text-secondary-text leading-relaxed">
              Celebrate your love with a romantic photoshoot in one of <strong
                >Kingston upon Thames'</strong
              > scenic outdoor locations. Whether it's a golden-hour stroll or a quiet
              moment by the water, I'll capture your connection beautifully.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-3">
              <strong>Event Photography</strong>
            </h3>
            <p class="text-secondary-text leading-relaxed">
              From birthdays to milestones, I'll document your special day with
              candid, vibrant photographs. Let me help you relive the laughter,
              joy, and togetherness of your celebration.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Expect -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          What to Expect from Your Session
        </h2>
        <p class="text-secondary-text leading-relaxed mb-8">
          As a <strong>family photographer</strong>, I understand that life with
          kids can be a little hectic (and let's face it, unpredictable!).
          That's why I aim to make your photoshoot as simple and stress-free as
          possible. I love working with kids and this is what I'm specialising
          in.
        </p>

        <ol class="space-y-4 text-secondary-text leading-relaxed mb-12 ml-6 list-decimal">
          <li>
            <strong>Free Pre-Shoot Consultation</strong>: We'll start with a
            quick chat to discuss your vision, location preferences, and any
            specific moments you'd like captured, or if you have any questions.
          </li>
          <li>
            <strong>Relaxed Photoshoot</strong>: On the day, my approach is
            flexible and fun. I'll guide you through the session while ensuring
            everyone feels comfortable and natural. Kids love me because my
            sessions are more about play than posing!
          </li>
          <li>
            <strong>Beautiful Results</strong>: After the session, I'll
            carefully edit each of your photos to enhance their natural beauty
            while keeping them timeless and authentic. Your images will be
            delivered in a secure online gallery, ready for downloading and
            sharing.
          </li>
        </ol>

        <p class="text-secondary-text leading-relaxed">
          I take on a limited number of clients each month to ensure every
          family gets the attention and care they deserve.
        </p>
      </div>
    </div>
  </section>

  <!-- Where I Work -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          Stunning Outdoor Locations in South West London
        </h2>
        <p class="text-secondary-text leading-relaxed mb-6">
          As a <strong>Kingston family photographer</strong>, I feel lucky to
          work in some of the most beautiful locations in <strong
            >South West London</strong
          >. Here are just a few of my favourites:
        </p>

        <ul class="space-y-4 text-secondary-text leading-relaxed mb-8 ml-6 list-disc">
          <li>
            <strong>Richmond Park</strong>: Perfect for families who love open
            spaces, golden sunsets, and scenic woodland backdrops.
          </li>
          <li>
            <strong>Bushy Park</strong>: A favourite for kids' sessions, with
            its wide open spaces, playful deer, and gorgeous seasonal colours.
          </li>
          <li>
            <strong>Twickenham Riverside</strong>: Ideal for couples and
            families who want romantic, timeless photos by the water.
          </li>
          <li>
            <strong>Canbury Gardens, Kingston</strong>: A peaceful spot with
            lush greenery and riverside charm—perfect for family strolls.
          </li>
        </ul>

        <p class="text-secondary-text leading-relaxed">
          If you have a special location in mind, I'm always happy to explore
          new places to make your session truly unique. I often capture families
          around Central London, there might be additional charges for the
          travelling expenses outside London, but I'm pretty flexible and we can
          discuss this on the initial call.
        </p>
      </div>
    </div>
  </section>

  <!-- Kind Words -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          Kind Words from Families Like Yours
        </h2>
        <blockquote
          class="border-l-4 border-pink pl-6 italic text-secondary-text leading-relaxed mb-4"
        >
          <p class="mb-4">
            We cannot recommend Gabi enough! She was the photographer for our
            wedding. Gabi captured every moment from entering the registry
            office to the end of our reception. She is a very talented and work
            driven young person with an eye for the details. Gabi, you were
            amazing, and we can't thank you enough for the beautiful photos!
          </p>
          <p>
            <a
              href="https://www.google.com/search?q=mellsnap&rlz=1C1VDKB_enGB1074GB1074&oq=mellsnap&gs_lcrp=EgZjaHJvbWUyBggAEEUYOTIGCAEQRRg8MgYIAhBFGDwyBggDEEUYPDIGCAQQRRg8MgYIBRBFGDwyBggGEEUYPNIBCDQ4ODNqMGo3qAIAsAIA&sourceid=chrome&ie=UTF-8#lrd=0x48760b263781020f:0x86089f8eb819ad46,1,,,,"
              target="_blank"
              rel="noopener"
              class="hover:text-pink transition-colors underline underline-offset-2">P. Pencheva</a
            >
          </p>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Why Outdoor Photography -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          Why Outdoor Photography is Special
        </h2>
        <p class="text-secondary-text leading-relaxed mb-6">
          There's something magical about outdoor family photography. Natural
          light, fresh air, and beautiful surroundings create the perfect
          backdrop for genuine, heartfelt moments. Unlike studio photography,
          outdoor sessions allow kids to move freely, explore, and have
          fun—which means more authentic smiles and laughter.
        </p>
        <p class="text-secondary-text leading-relaxed">
          As a <strong>Kingston family photographer</strong>, I know the best
          spots in the area to capture these moments, from open parks to
          riverside paths. Whether it's the vibrant colours of autumn leaves or
          the golden light of summer evenings, outdoor photography brings a
          unique charm to your family photos.
        </p>
      </div>
    </div>
  </section>

  <!-- Get in Touch -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">Get in Touch</h2>
        <p class="text-secondary-text leading-relaxed mb-6">
          If you're looking for a <strong
            >family photographer in Kingston upon Thames</strong
          > or the surrounding areas, I'd love to hear from you. Whether you're planning
          a relaxed family session, a special milestone shoot, or an event, let's
          create beautiful memories together.
        </p>
        <p class="text-secondary-text leading-relaxed mb-6">
          <strong
            ><a href="/contact/" class="hover:text-pink transition-colors underline underline-offset-2"
              >Contact me today to book your session</a
            ></strong
          > or learn more about how I can help:
        </p>

        <ul class="space-y-2 text-secondary-text leading-relaxed mb-12 ml-6 list-disc">
          <li>Email: <strong>contact@mellsnap.co.uk</strong></li>
          <li>Phone: <strong>07722 050 936</strong></li>
        </ul>

        <p class="text-secondary-text leading-relaxed">
          Let's capture the joy and connection of your family in stunning
          outdoor locations across <strong>South West London</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <Image
      inferSize
      src={aboutImage}
      alt="colourful kite on a blue sky"
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2
          class="font-ephesis! text-3xl md:text-4xl lg:text-5xl text-white mb-6"
        >
          Ready to Book?
        </h2>
        <p class="text-white/90 mb-10">
          Get in touch to check availability and book your session.
        </p>
        <a
          class="btn bg-green text-white hover:bg-green-500"
          href="/free-consultation/"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
