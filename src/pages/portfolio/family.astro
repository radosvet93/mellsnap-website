---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { Image } from "astro:assets";
import Lightbox from "../../components/Lightbox.astro";
import threeGenerationsBench from "../../images/family/three-generations-bench.jpg";
import parentsSwingingToddler from "../../images/family/parents-swinging-toddler.jpg";
import mumLiftingToddler from "../../images/family/mum-lifting-toddler.jpg";
import dadToddlerUpsideDown from "../../images/family/dad-toddler-upside-down.jpg";
import mumBabyCheek from "../../images/family/mum-baby-cheek.jpg";
import parentsKissingBaby from "../../images/family/parents-kissing-baby.jpg";
import parentsWalkingToddler from "../../images/family/parents-walking-toddler.jpg";
import parentsKissingToddler from "../../images/family/parents-kissing-toddler.jpg";
import familyDucksPond from "../../images/blog/family-ducks-pond.jpg";

const familyPhotos39 = [
  { src: threeGenerationsBench, alt: "Three generations of a family smiling together on a park bench with the little ones" },
  { src: parentsSwingingToddler, alt: "Parents swinging their toddler between them along a leafy garden path" },
  { src: mumLiftingToddler, alt: "Mum lifting her laughing toddler up high among ferns and flowers" },
  { src: dadToddlerUpsideDown, alt: "Dad holding his giggling toddler upside down in a garden" },
  { src: parentsWalkingToddler, alt: "Parents walking hand in hand with their toddler along a garden path" },
  { src: parentsKissingToddler, alt: "Parents kissing their toddler on both cheeks under a willow tree" },
];

const familyPhotos101 = [
  { src: mumBabyCheek, alt: "Smiling mum cheek to cheek with her baby sticking out her tongue" },
  { src: parentsKissingBaby, alt: "Parents kissing their baby daughter on both cheeks in a garden" },
  { src: familyDucksPond, alt: "Parents smiling as their toddler meets the ducks by a pond", position: "object-[22%_center]" },
];
---

<BaseLayout
  title="Family Portfolio"
  description="Family photography portfolio by MellSnap. Capturing authentic family moments in London."
>
  <!-- Hero -->
  <section class="py-20 md:py-28 bg-linen">
    <div class="container">
      <div class="text-center">
        <p class="label mb-4">Portfolio</p>
        <h1 class="text-primary-text">Family</h1>
        <p class="text-secondary-text mt-6 max-w-2xl mx-auto">
          Celebrating the beautiful chaos and unconditional love of family life.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 bg-white max-w-5xl mx-auto">
    <div class="container">
      <h2 class="text-primary-text font-bold mb-6">
        Why I Love Outdoor Family Photoshoots
      </h2>

      <p class="text-secondary-text mb-12">
        There's just something special about photographing families outdoors.
        One of my favourite types of shoots is capturing families being
        themselves—laughing, playing, and enjoying each other's company. Outdoor
        family photoshoot in London lets your family's personality shine through
        in a way that studio shoots sometimes just can't capture.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-16">
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/family/125-Web.jpg"
          alt="Two mums lifting their babies into the air on a street lit with festoon lights"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          fetchpriority="high"
          loading="eager"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/family/111-Web-2.jpg"
          alt="Two mums laughing with their babies in winter hats under festoon lights"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          fetchpriority="high"
          loading="eager"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/family/052-Web.jpg"
          alt="Mum in a patterned jumper holding her baby in a knitted bobble hat by the city lights"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          fetchpriority="high"
          loading="eager"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/family/138-Web.jpg"
          alt="Two mums walking and chatting with their babies on a cobbled street"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/family/122-Web-2.jpg"
          alt="Two mums holding their babies and smiling at each other on a cobbled street"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/family/133-Web-1.jpg"
          alt="Two mums walking away down a cobbled street carrying their babies"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        {
          familyPhotos39.map((photo) => (
            <Image
              src={photo.src}
              alt={photo.alt}
              class:list={["aspect-square img-portfolio cursor-pointer w-full h-auto object-cover", photo.position]}
              loading="lazy"
            />
          ))
        }
      </div>

      <h2 class="text-primary-text font-bold mb-6">
        The Beauty of Natural Moments
      </h2>

      <p class="text-secondary-text mb-12">
        For me, the magic happens in the in-between moments. Sure, we'll take a
        few posed shots, but I love capturing the candid ones—the moments where
        everyone feels relaxed, and the unplanned interactions show the real
        bond you share. Being outdoors, and enjoying yourselves as a family,
        brings out those genuine smiles and connections that truly shine.
        Whether you're playing in the park, walking through the woods, or even
        having a little cuddle, these are the memories that you'll treasure.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-16">
        <Image
          loading="lazy"
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/family/058-Web.jpg"
          alt="Dad gently holding his curly-haired toddler among green trees"
          inferSize
