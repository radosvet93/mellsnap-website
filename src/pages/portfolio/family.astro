          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        {
          familyPhotos101.map((photo) => (
            <Image
              src={photo.src}
              alt={photo.alt}
              class:list={["aspect-square img-portfolio cursor-pointer w-full h-auto object-cover", photo.position]}
              loading="lazy"
            />
