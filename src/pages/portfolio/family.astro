---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";

const images = [
  "https://images.unsplash.com/photo-1609220136736-443140cffec6?w=800&h=600&fit=crop",
  "https://images.unsplash.com/photo-1511895426328-dc8714191300?w=800&h=600&fit=crop",
  "https://images.unsplash.com/photo-1475503572774-15a45e5d60b9?w=800&h=600&fit=crop",
  "https://images.unsplash.com/photo-1478098711619-5ab0b478d6e6?w=800&h=600&fit=crop",
  "https://images.unsplash.com/photo-1476703993599-0035a21b17a9?w=800&h=600&fit=crop",
  "https://images.unsplash.com/photo-1491013516836-7db643ee125a?w=800&h=600&fit=crop",
];
---

<BaseLayout
  title="Family Portfolio"
  description="Family photography portfolio by MellSnap. Capturing authentic family moments in London."
>
  <!-- Hero -->
  <section class="py-20 md:py-28 bg-section-bg">
    <div class="container">
      <div class="text-center">
        <p class="label mb-4">Portfolio</p>
        <h1
          class="font-cormorant text-4xl md:text-5xl lg:text-6xl text-primary-text"
        >
          Family
        </h1>
        <p
          class="font-cormorant text-xl text-secondary-text mt-6 max-w-2xl mx-auto"
        >
          Celebrating the beautiful chaos and unconditional love of family life.
        </p>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-6xl mx-auto">
        {
          images.map((img, i) => (
            <div class="img-hover aspect-[4/3]">
              <img
                src={img}
                alt={`Family photography ${i + 1}`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>

      <div class="text-center mt-16">
        <Button href="/contact/" variant="primary">
          Book a Family Session
        </Button>
      </div>
    </div>
  </section>

  <!-- Back Link -->
  <section class="py-10 bg-section-bg">
    <div class="container text-center">
      <a href="/portfolio/" class="nav-link hover:text-pink transition-colors">
        &larr; Back to Portfolio
      </a>
    </div>
  </section>
</BaseLayout>
