          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/children/DSCF1169.jpg"
          alt="Blonde little girl for a children photoshoot from Mellsnap"
          inferSize
          class="aspect-square img-portfolio w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/children/DSCF0592.jpg"
          alt="Two toddlers, brother and sister with tulips flower, photo session in Holland park, family outdoor photoshoot from Mellsnap"
          inferSize
          class="aspect-square img-portfolio w-full h-auto object-cover"
          loading="lazy"
        />
      </div>

      <h2 class="text-primary-text font-bold mb-6">
        First Birthday Celebrations
      </h2>

      <p class="text-secondary-text mb-12">
        Celebrate your little one's first birthday with a memorable outdoor cake
        smash photoshoot. These sessions capture the joy, messiness, and pure
        delight of your baby's milestone moment in a relaxed park setting.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-16">
        <Image
