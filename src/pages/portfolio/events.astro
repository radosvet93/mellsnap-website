---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { Image } from "astro:assets";
import Lightbox from "../../components/Lightbox.astro";
import birthdayCake from "../../images/events/birthday-cake.jpg";
import balloonHat from "../../images/events/balloon-hat.jpg";
import dancing from "../../images/events/dancing.jpg";
import partyGames from "../../images/events/party-games.jpg";
import friendsTable from "../../images/events/friends-table.jpg";
import birthdayLift from "../../images/events/birthday-lift.jpg";
import gettingReady from "../../images/events/birthday-getting-ready.jpg";
import girlVeil from "../../images/events/birthday-girl-veil.jpg";
import cakeWindow from "../../images/events/birthday-cake-window.jpg";

const partyPhotos = [
  { src: birthdayCake, alt: "Birthday girl smiling at her rainbow birthday cake in front of a pink balloon arch" },
  { src: balloonHat, alt: "Smiling little boy wearing a balloon hat at a birthday party" },
  { src: dancing, alt: "Children dancing with their arms in the air at a birthday party" },
  { src: partyGames, alt: "Children sitting in a circle playing a game with party entertainers" },
  { src: friendsTable, alt: "Little boy with face paint laughing with a friend at the party table" },
  { src: birthdayLift, alt: "Birthday girl being lifted into the air by laughing party guests" },
];

const memoryPhotos = [
  { src: gettingReady, alt: "Black and white photo of a girl in an elegant black dress and gloves getting ready for her birthday party" },
  { src: girlVeil, alt: "Black and white photo of a birthday girl twirling in a black tulle dress under a happy 10th birthday sign" },
  { src: cakeWindow, alt: "Black and white photo of a birthday girl admiring her Chanel-themed birthday cake by the window" },
];
---

<BaseLayout
  title="Events Portfolio"
  description="Event photography portfolio by MellSnap. Birthday parties, celebrations and special events in London."
>
  <!-- Hero -->
  <section class="py-20 md:py-28 bg-linen">
    <div class="container">
      <div class="text-center">
        <p class="label mb-4">Portfolio</p>
        <h1 class="text-primary-text">Events</h1>
        <p class="text-secondary-text mt-6 max-w-2xl mx-auto">
          Documenting birthdays, celebrations, and special moments you'll want
          to remember.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 bg-white max-w-5xl mx-auto">
    <div class="container">
      <p class="text-secondary-text mb-12">
        Whether it's a birthday party, anniversary, or family gathering, event
        photography is all about capturing the true essence of the celebration.
        My approach focuses on documenting those real, candid moments, so that
        every time you look back at your photos, you'll relive the joy and
        atmosphere of the day all over again.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-16">
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/002-Web.jpg"
          alt="Birthday event, celebrating 30th anniversary, decoration for the couple celebrating birthday together with family"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          fetchpriority="high"
          loading="eager"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/021-Web-1-e1731532212897.jpg"
          alt="Birthday event, celebrating 30th anniversary, decoration for the couple celebrating birthday together with family"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          fetchpriority="high"
          loading="eager"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/022-Web-e1731532159263.jpg"
          alt="Birthday event, celebrating 30th anniversary, decoration for the couple celebrating birthday together with family"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          fetchpriority="high"
          loading="eager"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/129-Web-1.jpg"
          alt="Birthday event, celebrating 30th anniversary, couple celebrating birthday together with family"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/162-Web.jpg"
          alt="Birthday event, celebrating 30th anniversary, couple celebrating birthday together with family"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/209-Web.jpg"
          alt="Birthday event, celebrating 30th anniversary, couple celebrating birthday together with family"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/035-Web-1.jpg"
          alt="18th birthday girl, celebrating with family and friends, having fun on the birthday party"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/135-Web.jpg"
          alt="18th birthday celebration, with family and friends, having fun on the birthday party"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/181-Web-1.jpg"
          alt="18th birthday celebration for a girl, with family and friends, having fun on the birthday party"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
      </div>

      <h2 class="md:text-4xl text-primary-text font-bold mb-6">
        Why Event Photography Matters?
      </h2>

      <p class="text-secondary-text mb-6">
        Event photography is all about documenting the magic of your
        celebrations. It goes beyond posed group shots to capture the
        spontaneous interactions, smiles, and candid moments that truly define
        your event. Whether it's the excitement of a birthday party or the
        warmth of an anniversary celebration, my goal is to blend into the
        background and let the day unfold naturally while capturing every joyful
        moment.
      </p>

      <p class="text-secondary-text mb-12">
        I've put together a post about <a
          href="/blog/why-hire-a-children-birthday-party-photographer/"
          class="hover:text-pink transition-colors underline underline-offset-2"
          >the importance of an event photographer</a
        > on special occasions, you can check that out for me details.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-16">
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF6561.jpg"
          alt="Birthday photo session, 4 year old boy birthday party, cake, face painting"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF0534.jpg"
          alt="Birthday party, children eating, waiting for the cake, a birthday photoshoot"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF0383.jpg"
          alt="Birthday party photoshoot, children playing on a birthday party"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF0457.jpg"
          alt="Birthday party photoshoot, children playing on a birthday party"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF8986.jpg"
          alt="Party decoration, Birthday event, birthday parties photography, children photoshoot from Mellsnap"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF1086.jpg"
          alt="Party decoration, birthday cake, balloons decoration. Birthday event, birthday parties photography, children photoshoot from Mellsnap"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
      </div>

      <h2 class="md:text-4xl text-primary-text font-bold mb-6">
        Perfect for Birthday Parties
      </h2>

      <p class="text-secondary-text mb-12">
        Birthday parties are a time for fun and excitement, especially for
        children. I thrive on capturing those special moments, from blowing out
        the candles to the joy of friends playing together. I'll document all
        the laughter and joy, creating a vibrant narrative of your celebration
        that you can cherish for years to come.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-16">
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/001-Web.jpg"
          alt="Birthday girl decoration for her 5th birthday party"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/115-Web.jpg"
          alt="Birthday cake for a girl who turns 5"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/313-Web.jpg"
          alt="Little girls giggling on birthday event party"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/317-Web.jpg"
          alt="Young children smiling and enjoying a birthday event"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/375-Web-e1731532071572.jpg"
          alt="Young children jumping, playing a game on a birthday party"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/181-Web.jpg"
          alt="Children on a birthday party, birthday girl with her friends having fun"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/238-Web.jpg"
          alt="Children on a birthday party, birthday girl with her friends having fun"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF1736.jpg"
          alt="Children on a birthday event, party for a 4 year old girl, birthday photoshoot"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/164-Web.jpg"
          alt="Group of kids dancing on fun music, having a bright light behind them and having a good time on a birthday party"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
      </div>

      <h2 class="md:text-4xl text-primary-text font-bold mb-6">
        Special Events I Love to Photograph
      </h2>

      <p class="text-secondary-text mb-6">
        <strong>Birthday Parties</strong>: Whether it's a child's birthday or a
        milestone celebration, I'll capture all the fun and excitement, from
        cake-cutting to party games.
      </p>

      <p class="text-secondary-text mb-6">
        <strong>Anniversaries</strong>: Celebrate your love story with beautiful
        images that showcase the connection between you and your partner, as
        well as the joy of those celebrating alongside you.
      </p>

      <p class="text-secondary-text mb-12">
        <strong>Family Gatherings</strong>: Every family has its own story, and
        I aim to tell yours through candid shots that capture the warmth and
        connections among family members.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-16">
        {
          partyPhotos.map((photo) => (
            <Image
              src={photo.src}
              alt={photo.alt}
              class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
              loading="lazy"
            />
          ))
        }
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF1069.jpg"
          alt="Two little boys running around a balloon"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF1070.jpg"
          alt="Two little boys running around a balloon"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/058-Web-1.jpg"
          alt="Children on a birthday party, birthday girl with her friends having fun"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
      </div>

      <h2 class="md:text-4xl text-primary-text font-bold mb-6">
        Creating Lasting Memories
      </h2>

      <p class="text-secondary-text mb-12">
        I believe that every event tells a story. My focus is on preserving that
        story in good photographs that reflect the spirit of the day. From the
        small details to the big moments, I aim to create a collection of images
        that bring your memories back to life every time you look at them.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-16">
        {
          memoryPhotos.map((photo) => (
            <Image
              src={photo.src}
              alt={photo.alt}
              class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
              loading="lazy"
            />
          ))
        }
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF4550.jpg"
          alt="Two ladies on a event, event photography"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF4481.jpg"
          alt="Two women talking and laughing on a beauty event"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF4076.jpg"
          alt="Two women hugging"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF3174-1-scaled.jpg"
          alt="Conversation between women, bulgarian woman in business event"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF3877-1-scaled.jpg"
          alt="Conversation between women, bulgarian woman in business"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF3886-scaled.jpg"
          alt="Three women listening and watching product presentation, bulgarian woman in business"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF4110-scaled.jpg"
          alt="Conversation between two women, bulgarian woman in business"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF3545-scaled.jpg"
          alt="Two woman explaining to customers, bulgarian woman in business"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
        <Image
          src="https://images.mellsnap.co.uk/file/mellsnap-website/portfolio/events/DSCF4090-scaled.jpg"
          alt="Two women smiling on a beauty event"
          inferSize
          class="aspect-square img-portfolio cursor-pointer w-full h-auto object-cover"
          loading="lazy"
        />
      </div>

      <div class="text-center mt-16">
        <Button href="/free-consultation/" variant="primary">
          Book Event Coverage
        </Button>
      </div>
    </div>
  </section>

  <!-- Back Link -->
  <section class="py-10 bg-linen">
    <div class="container text-center">
      <a
        href="/portfolio/"
        class="nav-link hover:text-pink transition-colors underline underline-offset-2"
      >
        &larr; Back to Portfolio
      </a>
    </div>
  </section>

  <Lightbox />
</BaseLayout>
