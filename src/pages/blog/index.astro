---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection(
  "blog",
  ({ data }) => data.published !== false,
);
const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="Photoshoot Tips & Locations in London | MellSnap"
  description="Family photoshoot tips, outfit ideas and my favourite parks and hidden spots in Kingston and London for natural, relaxed photos."
>
  <!-- Hero -->
  <section class="py-20 md:py-28 bg-linen">
    <div class="container">
      <div class="text-center">
        <p class="label mb-4">Blog</p>
        <h1 class="text-primary-text">Photoshoot Tips & Location Ideas</h1>
        <p class="text-secondary-text mt-6 max-w-2xl mx-auto">
          My tips for relaxed photoshoots, what to wear, and my favourite
          parks and hidden spots around Kingston and London.
        </p>
      </div>
    </div>
  </section>

  <!-- Blog Posts -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {
          sortedPosts.map((post) => (
            <article class="group">
              <a href={`/blog/${post.id}/`} class="block">
                <div class="img-hover aspect-3/2 mb-6">
                  <Image
                    inferSize={typeof post.data.image === "string"}
                    src={post.data.image}
                    alt={post.data.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <time class="label">
                  {post.data.date.toLocaleDateString("en-GB", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  })}
                </time>
                <h2 class="md:text-xl! lg:text-2xl! text-primary-text mt-2 mb-3 group-hover:text-pink transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-sm! text-secondary-text">{post.data.excerpt}</p>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
