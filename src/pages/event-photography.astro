---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { packageJsonLd } from "../utils/structuredData";
import FaqSection from "../components/FaqSection.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { services } from "../data/services";
import { Image } from "astro:assets";
import birthdayCake from "../images/events/birthday-cake.jpg";
import balloonHat from "../images/events/balloon-hat.jpg";
import dancing from "../images/events/dancing.jpg";
import partyGames from "../images/events/party-games.jpg";
import friendsTable from "../images/events/friends-table.jpg";
import birthdayLift from "../images/events/birthday-lift.jpg";

// Ordered so each of the 3 columns pairs a portrait with a landscape photo
const partyPhotos = [
  { src: birthdayCake, alt: "Birthday girl smiling at her rainbow birthday cake in front of a pink balloon arch" },
  { src: dancing, alt: "Children dancing with their arms in the air at a birthday party" },
  { src: partyGames, alt: "Children sitting in a circle playing a game with party entertainers" },
  { src: balloonHat, alt: "Smiling little boy wearing a balloon hat at a birthday party" },
  { src: birthdayLift, alt: "Birthday girl being lifted into the air by laughing party guests" },
  { src: friendsTable, alt: "Little boy with face paint laughing with a friend at the party table" },
];

const eventService = services.find((service) => service.id === "event");

const faqs = [
  {
    question: "Can I book additional time?",
    answer: "Yes! The package includes the first hour, and each additional hour is £100. Just let me know how long your event runs when booking, and we'll plan the coverage around your schedule.",
  },
  {
    question: "Do you capture both posed and candid shots?",
    answer: "Absolutely. I'll blend candid moments with any posed group photos you'd like, so you get a well-rounded gallery.",
  },
  {
    question: "When will I receive my photos?",
    answer: "You'll receive your professionally edited images within 7 to 10 days, delivered in a secure online gallery for easy sharing and downloading.",
  },
  {
    question: "Do you offer prints?",
    answer: "I don't offer prints, but all images are delivered in two formats: social media-ready (optimised for sharing online) and high-resolution for printing (ideal for framed photos or large canvases). This way, you have the flexibility to use your images however you like!",
  },
  {
    question: "Do you offer video services?",
    answer: "I focus solely on photography, so I don't offer video services. However, my photos are carefully crafted to tell the story of your event, capturing the emotions and key moments just as beautifully as a video would.",
  },
];

const jsonLd = eventService
  ? packageJsonLd(eventService, "/event-photography/", "Capture the fun and joy of indoor and outdoor events, from birthdays to family gatherings, with natural, candid event photography in London.", faqs)
  : null;
---

<BaseLayout
  title="Event Photography"
  description="Capture the fun and joy of indoor and outdoor events, from birthdays to family gatherings, with natural, candid event photography in London."
  ogImage={eventService?.image.src}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <!-- Hero -->
  <section class="relative overflow-hidden bg-linen">
    <div class="flex flex-col md:flex-row md:min-h-screen">
      <div
        class="flex-none md:w-1/2 flex items-center py-16 px-8 md:pl-8 lg:pl-8 xl:pl-8 md:pr-0 relative z-10"
      >
        <div
          class="bg-white shadow-2xl p-8 md:p-10 lg:p-12 w-full md:translate-x-10"
        >
          <p class="font-raleway text-xs uppercase tracking-widest mb-5">
            Photography Package
          </p>

          <h1 class="text-primary-text leading-none mb-6">Event Photography</h1>

          <p class="font-ephesis text-pink text-4xl mb-8 leading-none">
            every moment, beautifully told
          </p>

          <p
            class="text-secondary-text font-cormorant text-xl italic mb-10 leading-relaxed"
          >
            From birthday parties to family gatherings — candid, natural
            coverage of your special occasion.
          </p>

          <div class="w-10 h-px bg-pink/40 mb-6"></div>

          <ul class="space-y-2.5 mb-8">
            {
              eventService?.features.map((feature) => (
                <li class="flex items-center gap-2.5 text-secondary-text text-sm">
                  <span class="w-1 h-1 rounded-full bg-pink flex-shrink-0" />
                  {feature}
                </li>
              ))
            }
          </ul>

          <div
            class="flex flex-wrap items-center justify-between gap-8 pt-2 border-t border-pink/20"
          >
            <div>
              <p class="label mb-1">Price</p>
              <p class="text-3xl font-cormorant font-bold text-primary-text">
                {eventService?.price}
              </p>
            </div>
            <Button href="/free-consultation/" variant="primary">
              Book a Free Consultation
            </Button>
          </div>
        </div>
      </div>

      <div class="relative flex-1 min-h-[70vw] md:min-h-0">
        <Image
          inferSize
          src="https://images.mellsnap.co.uk/file/mellsnap-website/services/001-Web.jpg"
          alt="Birthday girl decoration for her 5th birthday party"
          class="absolute inset-0 w-full h-full object-cover"
          fetchpriority="high"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Introduction -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <p class="text-secondary-text leading-relaxed mb-6">
          Every event tells a story, and I'm here to make sure it's one you'll
          never forget. My <strong class="text-primary-text"
            >Event Photography Package</strong
          > is designed to document your special occasions – from joyful birthday
          parties to heartfelt engagements and everything in between.
        </p>
        <p class="text-secondary-text leading-relaxed">
          With a focus on candid, natural moments and beautifully composed
          shots, I'll help you relive your event through the uniquely captured
          emotional images that you'll cherish forever.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Image -->
  <section class="bg-linen">
    <div class="container py-10">
      <div class="max-w-4xl mx-auto">
        <Image
          inferSize
          src="https://images.mellsnap.co.uk/file/mellsnap-website/services/238-Web.jpg"
          alt="Children on a birthday party, birthday girl with her friends having fun"
          class="w-full aspect-[3/2] object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          What's Included in My Event Photography Package?
        </h2>
        <p class="text-secondary-text mb-8">
          Here's what's included in this comprehensive package:
        </p>
        <ul class="space-y-4 text-secondary-text">
          <li class="list-disc ml-8">
            <strong class="text-primary-text"
              >The first hour of coverage, then £100 for each additional hour</strong
            > – Flexible and adaptable to your event schedule, so you only book the
            time you need.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text"
              >80+ professionally edited digital images per hour</strong
            > – A complete gallery of high-quality photos to capture the essence of
            your celebration.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">7–10 day delivery</strong> – You won't
            have to wait long to enjoy your photos.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Secure online gallery</strong> – Your
            photos are delivered in a private gallery for easy viewing, sharing, and
            downloading, and they are active for up to one month.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Natural and soft edit</strong> – Each
            image is carefully cropped and framed, with gentle, natural edits of the
            colours, lighting and white balance, there are no harsh filters or heavy
            retouching.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Why Choose -->
  <section class="py-20 md:py-28 bg-linen">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          Why Choose My Event Photography Package?
        </h2>
        <p class="text-secondary-text mb-10">
          Planning an event takes time and effort, so let me take one thing off
          your plate: capturing the memories. This package is perfect for those
          who want a professional yet relaxed photography experience tailored to
          their celebration.
        </p>

        <div class="space-y-8">
          <div>
            <h3 class="text-primary-text mb-3">1. Moments That Matter</h3>
            <p class="text-secondary-text">
              I specialise in capturing the in-between moments – the laughter,
              the hugs, the spontaneous joy – as well as the must-have shots
              like group photos and key event highlights, we can discuss before
              the session for any special request or moments that are essential.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-3">
              2. Personalised to Your Event
            </h3>
            <p class="text-secondary-text">
              Every event is unique, and I tailor my approach to suit yours.
              Whether it's an intimate gathering at home, a lively birthday
              party in the park, or a romantic engagement dinner, I'll blend
              into the background and document your day as it naturally unfolds.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-3">3. Flexible Coverage</h3>
            <p class="text-secondary-text">
              Book the first hour and add extra hours as you need, so I'm there
              for the moments that matter most – whether that's the whole party or just
              the key highlights.
            </p>
          </div>

          <div>
            <h3 class="text-primary-text mb-3">
              4. Beautiful, Natural Results
            </h3>
            <p class="text-secondary-text">
              My editing style keeps your photos looking genuine and timeless,
              so you can treasure them for years to come.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Events I Cover -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          Special Events I Love to Photograph
        </h2>
        <ul class="space-y-4 text-secondary-text">
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Birthday Parties</strong> – Whether
            it's a child's birthday or a milestone celebration, I'll capture all the
            fun and excitement, from cake-cutting to party games.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Engagements</strong> – Capture the excitement
            and joy of this special milestone with natural, romantic photos.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Anniversaries</strong> – Celebrate your
            love story with beautiful images that showcase the connection between
            you and your partner, as well as the joy of those celebrating alongside
            you.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text">Family Gatherings</strong> – Every family
            has its own story, and I aim to tell yours through candid shots that capture
            the warmth and connections among family members.
          </li>
          <li class="list-disc ml-8">
            <strong class="text-primary-text"
              >Baby Showers, Baby Reveals or Christenings</strong
            > – Document these precious celebrations with beautiful, heartfelt images.
          </li>
        </ul>
        <div class="grid grid-cols-2 gap-3 md:block md:columns-3 mt-10">
          {
            partyPhotos.map((photo) => (
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[400, 800]}
                sizes="(min-width: 768px) 320px, 50vw"
                class="w-full aspect-4/5 object-cover md:aspect-auto md:h-auto md:mb-3 md:break-inside-avoid"
                loading="lazy"
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- What happens on the day -->
  <section class="py-20 md:py-28 bg-linen">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          What Happens on the Day?
        </h2>
        <p class="text-secondary-text mb-8">
          When you book my Event Photography Package, here's what to expect:
        </p>
        <ol class="space-y-4 text-secondary-text mb-8">
          <li class="list-decimal ml-8">
            <strong class="text-primary-text">Arrive early</strong> – I'll arrive
            ahead of time to get familiar with the space, meet key people, and capture
            any pre-event details.
          </li>
          <li class="list-decimal ml-8">
            <strong class="text-primary-text">Blend in</strong> – I'll quietly move
            around to capture candid moments without disrupting the flow of your event.
          </li>
          <li class="list-decimal ml-8">
            <strong class="text-primary-text">Essential shots</strong> – I'll make
            sure to capture the key moments and people – whether it's a cake cutting,
            a speech, or a special toast.
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Flexible Locations -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="md:text-4xl text-primary-text mb-8">
          Flexible Locations Across South-West London
        </h2>
        <p class="text-secondary-text mb-8">
          I cover events across South-West London, including <strong
            >Kingston</strong
          >, <strong>Richmond</strong>,
          <strong>Surbiton</strong>, <strong>Twickenham</strong> and <strong
            >Central London</strong
          >. If your event is outside the range I cover, let's chat, there might
          be an additional travel fee.
        </p>
        <p class="text-secondary-text mb-8">
          Whether you're hosting an intimate gathering at home, a lively
          birthday party in the park, or a romantic engagement dinner, I'm here
          to capture your special moments wherever they happen.
        </p>
      </div>
    </div>
  </section>

  <FaqSection title="Event Photography FAQs" faqs={faqs} />

  <CtaBanner
    title="Ready to Capture Your Event?"
    text={"Let's document your special occasion with beautiful, natural photography."}
    buttonText="Book a Free Consultation"
  />
</BaseLayout>
