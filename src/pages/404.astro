---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<BaseLayout title="Page Not Found">
  <section class="py-28 md:py-40 bg-section-bg">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center">
        <p class="font-ephesis text-6xl md:text-8xl text-pink mb-6">404</p>
        <h1 class="text-primary-text mb-6">Page Not Found</h1>
        <p class="text-secondary-text mb-10">
          Oops! The page you're looking for seems to have wandered off. Let's
          get you back on track.
        </p>
        <Button href="/" variant="primary"> Return Home </Button>
      </div>
    </div>
  </section>
</BaseLayout>
