# Google Places API Configuration
# Get these values from Google Cloud Console

# 1. Enable "Places API (New)" in Google Cloud Console
# 2. Create an API key (restrict to Places API for security)
# 3. Get your Place ID from Google Maps share URL or use Place Finder tool:
#    https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder

GOOGLE_PLACES_API_KEY=your_api_key_here
GOOGLE_PLACE_ID=your_place_id_here

# Example:
# GOOGLE_PLACES_API_KEY=AIzaSyA1234567890abcdefghijklmnopqrstuv
# GOOGLE_PLACE_ID=ChIJN1t_tDeuEmsRUsoyG83frY4

# Note: Without these credentials, the site will use fallback hardcoded reviews
